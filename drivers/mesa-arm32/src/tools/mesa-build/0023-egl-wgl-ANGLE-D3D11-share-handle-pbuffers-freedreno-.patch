+#ifdef STW_COREWINDOW
+/* EGL_ANGLE_d3d_share_handle_client_buffer */
+static _EGLSurface *
+wgl_create_pbuffer_from_client_buffer(_EGLDisplay *disp, EGLenum buftype,
+                                      EGLClientBuffer buffer, _EGLConfig *conf,
+                                      const EGLint *attrib_list)
+{
+   struct wgl_egl_display *wgl_dpy = wgl_egl_display(disp);
+   struct wgl_egl_config *wgl_conf = wgl_egl_config(conf);
+   HANDLE share = (HANDLE)buffer;
+   unsigned tw, th;
+   int tf;
+
+   if (buftype != EGL_D3D_TEXTURE_2D_SHARE_HANDLE_ANGLE) {
+      _eglError(EGL_BAD_PARAMETER, "eglCreatePbufferFromClientBuffer");
+      return NULL;
+   }
+   if (!stw_query_shared_texture(share, &tw, &th, &tf)) {
+      _eglError(EGL_BAD_PARAMETER, "eglCreatePbufferFromClientBuffer");
+      return NULL;
+   }
+   if (!tf) {
+      _eglError(EGL_BAD_MATCH, "eglCreatePbufferFromClientBuffer");
+      return NULL;
+   }
+
+   struct wgl_egl_surface *wgl_surf = calloc(1, sizeof(*wgl_surf));
+   if (!wgl_surf) {
+      _eglError(EGL_BAD_ALLOC, "eglCreatePbufferFromClientBuffer");
+      return NULL;
+   }
+   if (!_eglInitSurface(&wgl_surf->base, disp, EGL_PBUFFER_BIT, conf,
+                        attrib_list, NULL)) {
+      free(wgl_surf);
+      return NULL;
+   }
+
+   /* EGL_WIDTH/EGL_HEIGHT neu co phai khop texture (mac dinh 0 = lay theo
+    * texture).
+    */
+   if ((wgl_surf->base.Width && (unsigned)wgl_surf->base.Width != tw) ||
+       (wgl_surf->base.Height && (unsigned)wgl_surf->base.Height != th)) {
+      free(wgl_surf);
+      _eglError(EGL_BAD_PARAMETER, "eglCreatePbufferFromClientBuffer");
+      return NULL;
+   }
+   wgl_surf->base.Width = tw;
+   wgl_surf->base.Height = th;
+
+   const struct stw_pixelformat_info *stw_conf = wgl_conf->stw_config[1]
+                                                    ? wgl_conf->stw_config[1]
+                                                    : wgl_conf->stw_config[0];
+   wgl_surf->fb = stw_pbuffer_create_shared(stw_conf, share, tw, th,
+                                            &wgl_dpy->base);
+   if (!wgl_surf->fb) {
+      free(wgl_surf);
+      _eglError(EGL_BAD_ALLOC, "eglCreatePbufferFromClientBuffer");
+      return NULL;
+   }
+   wgl_surf->d3d_shared = true;
+   wgl_surf->fb->swap_interval = 1;
+   stw_framebuffer_unlock(wgl_surf->fb);
+
+   return &wgl_surf->base;
+}
+
+/* EGL_ANGLE_query_surface_pointer */
+static EGLBoolean
+wgl_query_surface_pointer_angle(_EGLDisplay *disp, _EGLSurface *surf,
+                                EGLint attribute, void **value)
+{
+   struct wgl_egl_surface *wgl_surf = wgl_egl_surface(surf);
+   if (attribute != EGL_D3D_TEXTURE_2D_SHARE_HANDLE_ANGLE)
+      return _eglError(EGL_BAD_ATTRIBUTE, "eglQuerySurfacePointerANGLE");
+   *value = wgl_surf->d3d_shared
+               ? (void *)stw_framebuffer_get_share_handle(wgl_surf->fb)
+               : NULL;
+   return EGL_TRUE;
+}
+#endif
+
 static EGLBoolean
 wgl_query_surface(_EGLDisplay *disp, _EGLSurface *surf, EGLint attribute,
                   EGLint *value)
@@ -784,6 +888,18 @@ wgl_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
 {
    struct wgl_egl_surface *wgl_surf = wgl_egl_surface(draw);
 
+   if (draw->Type != EGL_WINDOW_BIT) {
+      /* Pbuffer D3D11 dung chung: swap = ve xong (D3D11 doc duoc). */
+      _EGLContext *ctx = _eglGetCurrentContext();
+      if (wgl_surf->d3d_shared && ctx) {
+         struct pipe_fence_handle *fence = NULL;
+         st_context_flush(wgl_egl_context(ctx)->ctx->st,
+                          ST_FLUSH_END_OF_FRAME | ST_FLUSH_WAIT, &fence, NULL,
+                          NULL);
+      }
+      return EGL_TRUE;
+   }
+
    stw_framebuffer_lock(wgl_surf->fb);
    HDC hdc = GetDC(wgl_surf->fb->hWnd);
    BOOL ret = stw_framebuffer_swap_locked(hdc, wgl_surf->fb);
@@ -1180,6 +1296,10 @@ struct _egl_driver _eglDriver = {
    .ReleaseTexImage = _eglReleaseTexImage,
    .SwapInterval = wgl_swap_interval,
    .SwapBuffers = wgl_swap_buffers,
+#ifdef STW_COREWINDOW
+   .CreatePbufferFromClientBuffer = wgl_create_pbuffer_from_client_buffer,
+   .QuerySurfacePointerANGLE = wgl_query_surface_pointer_angle,
+#endif
    .WaitClient = wgl_wait_client,
    .WaitNative = wgl_wait_native,
    .CreateImageKHR = wgl_create_image_khr,
