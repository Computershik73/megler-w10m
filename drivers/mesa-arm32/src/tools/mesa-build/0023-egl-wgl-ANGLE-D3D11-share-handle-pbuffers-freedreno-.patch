 }
+
+/*
+ * Pbuffer dung chung voi D3D11 (EGL_ANGLE_surface_d3d_texture_2d_share_handle
+ * va EGL_ANGLE_d3d_share_handle_client_buffer). Mot texture (front = back),
+ * khong swapchain. Dong bo: cho fence Mesa o eglSwapBuffers/glFinish.
+ */
+struct fd_wgl_pbuffer {
+   struct stw_winsys_framebuffer base;
+   struct pipe_screen *screen;
+   struct pipe_context *ctx;
+   struct pipe_resource *res;
+   ComPtr<ID3D11Texture2D> tex;
+   HANDLE share;
+};
+
+static SRWLOCK pbuffer_dev_lock = SRWLOCK_INIT;
+static ID3D11Device *pbuffer_dev; /* dung chung moi pbuffer, khong giai phong */
+
+static ID3D11Device *
+get_pbuffer_device(void)
+{
+   AcquireSRWLockExclusive(&pbuffer_dev_lock);
+   if (!pbuffer_dev) {
+      static const D3D_FEATURE_LEVEL levels[] = {
+         D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0,
+         D3D_FEATURE_LEVEL_10_1, D3D_FEATURE_LEVEL_10_0,
+         D3D_FEATURE_LEVEL_9_3,  D3D_FEATURE_LEVEL_9_1,
+      };
+      HRESULT hr = D3D11CreateDevice(
+         nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+         D3D11_CREATE_DEVICE_BGRA_SUPPORT, levels, ARRAYSIZE(levels),
+         D3D11_SDK_VERSION, &pbuffer_dev, nullptr, nullptr);
+      if (FAILED(hr)) {
+         debug_printf("fd_wgl: pbuffer D3D11CreateDevice 0x%08lx\n",
+                      (unsigned long)hr);
+         pbuffer_dev = nullptr;
+      }
+   }
+   ID3D11Device *dev = pbuffer_dev;
+   ReleaseSRWLockExclusive(&pbuffer_dev_lock);
+   return dev;
+}
+
+static fd_wgl_pbuffer *
+fd_wgl_pb(struct stw_winsys_framebuffer *fb)
+{
+   return (fd_wgl_pbuffer *)fb;
+}
+
+static void
+fd_wgl_pbuffer_destroy(struct stw_winsys_framebuffer *pfb,
+                       struct pipe_context *ctx)
+{
+   fd_wgl_pbuffer *pb = fd_wgl_pb(pfb);
+   (void)ctx;
+   pipe_resource_reference(&pb->res, NULL);
+   pb->tex.Reset();
+   delete pb;
+}
+
+static void
+fd_wgl_pbuffer_resize(struct stw_winsys_framebuffer *pfb,
+                      struct pipe_context *ctx, struct pipe_resource *templ)
+{
+   /* Kich thuoc co dinh theo texture D3D11. */
+   (void)templ;
+   fd_wgl_pb(pfb)->ctx = ctx;
+}
+
+static struct pipe_resource *
+fd_wgl_pbuffer_get_resource(struct stw_winsys_framebuffer *pfb,
+                            enum st_attachment_type statt)
+{
+   (void)statt;
+   struct pipe_resource *res = NULL;
+   pipe_resource_reference(&res, fd_wgl_pb(pfb)->res);
+   return res;
+}
+
+/* "present" cua pbuffer = cho Mesa ve xong (D3D11 doc duoc). */
+static void
+fd_wgl_pbuffer_finish(fd_wgl_pbuffer *pb, struct pipe_context *ctx)
+{
+   if (!ctx)
+      return;
+   struct pipe_fence_handle *fence = NULL;
+   ctx->flush(ctx, &fence, 0);
+   if (fence) {
+      pb->screen->fence_finish(pb->screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      pb->screen->fence_reference(pb->screen, &fence, NULL);
+   }
+}
+
+static bool
+fd_wgl_pbuffer_present(struct stw_winsys_framebuffer *pfb, int interval)
+{
+   (void)interval;
+   fd_wgl_pbuffer *pb = fd_wgl_pb(pfb);
+   fd_wgl_pbuffer_finish(pb, pb->ctx);
+   return true;
+}
+
+static void
+fd_wgl_pbuffer_flush_frontbuffer(struct stw_winsys_framebuffer *pfb,
+                                 struct pipe_context *ctx)
+{
+   fd_wgl_pbuffer *pb = fd_wgl_pb(pfb);
+   pb->ctx = ctx;
+   fd_wgl_pbuffer_finish(pb, ctx);
+}
+
+static HANDLE
+fd_wgl_pbuffer_get_share_handle(struct stw_winsys_framebuffer *pfb)
+{
+   return fd_wgl_pb(pfb)->share;
+}
+
+static bool
+open_shared(HANDLE share, ComPtr<ID3D11Texture2D> &tex,
+            D3D11_TEXTURE2D_DESC *desc)
+{
+   ID3D11Device *dev = get_pbuffer_device();
+   if (!dev || !share)
+      return false;
+   HRESULT hr = dev->OpenSharedResource(share, IID_PPV_ARGS(&tex));
+   if (FAILED(hr)) {
+      debug_printf("fd_wgl: OpenSharedResource 0x%08lx\n", (unsigned long)hr);
+      return false;
+   }
+   tex->GetDesc(desc);
+   return true;
+}
+
+extern "C" bool
+fd_wgl_query_shared_texture(HANDLE share, unsigned *width, unsigned *height,
+                            enum pipe_format *format)
+{
+   ComPtr<ID3D11Texture2D> tex;
+   D3D11_TEXTURE2D_DESC desc;
+   if (!open_shared(share, tex, &desc))
+      return false;
+   *width = desc.Width;
+   *height = desc.Height;
+   *format = PIPE_FORMAT_NONE;
+   if (desc.MipLevels == 1 && desc.ArraySize == 1 &&
+       desc.SampleDesc.Count == 1) {
+      if (desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM)
+         *format = PIPE_FORMAT_B8G8R8A8_UNORM;
+      else if (desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM)
+         *format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   }
+   return true;
+}
+
+extern "C" struct stw_winsys_framebuffer *
+fd_wgl_create_shared_pbuffer(struct pipe_screen *screen, HANDLE import,
+                             unsigned width, unsigned height,
+                             enum pipe_format format)
+{
+   ID3D11Device *dev = get_pbuffer_device();
+   if (!dev || !width || !height || util_format_get_blocksize(format) != 4)
+      return NULL;
+
+   fd_wgl_pbuffer *pb = new (std::nothrow) fd_wgl_pbuffer();
+   if (!pb)
+      return NULL;
+   pb->screen = screen;
+
+   if (import) {
+      D3D11_TEXTURE2D_DESC desc;
+      if (!open_shared(import, pb->tex, &desc) || desc.Width != width ||
+          desc.Height != height) {
+         delete pb;
+         return NULL;
+      }
+      pb->share = import;
+   } else {
+      D3D11_TEXTURE2D_DESC td = {};
+      td.Width = width;
+      td.Height = height;
+      td.MipLevels = 1;
+      td.ArraySize = 1;
+      td.Format = (format == PIPE_FORMAT_R8G8B8A8_UNORM ||
+                   format == PIPE_FORMAT_R8G8B8X8_UNORM)
+                     ? DXGI_FORMAT_R8G8B8A8_UNORM
+                     : DXGI_FORMAT_B8G8R8A8_UNORM;
+      td.SampleDesc.Count = 1;
+      td.Usage = D3D11_USAGE_DEFAULT;
+      td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+      td.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+      HRESULT hr = dev->CreateTexture2D(&td, nullptr, &pb->tex);
+      ComPtr<IDXGIResource> dres;
+      if (FAILED(hr) || FAILED(pb->tex.As(&dres)) ||
+          FAILED(dres->GetSharedHandle(&pb->share)) || !pb->share) {
+         debug_printf("fd_wgl: pbuffer shared texture that bai 0x%08lx\n",
+                      (unsigned long)hr);
+         delete pb;
+         return NULL;
+      }
+   }
+
+   struct pipe_resource t = {};
+   t.target = PIPE_TEXTURE_2D;
+   t.format = format;
+   t.width0 = width;
+   t.height0 = height;
+   t.depth0 = t.array_size = 1;
+   t.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW |
+            PIPE_BIND_LINEAR | PIPE_BIND_SHARED;
+   t.usage = PIPE_USAGE_DEFAULT;
+
+   /* KMD Qualcomm: texture shared LINEAR, pitch = width*4 lam tron 64. */
+   struct winsys_handle wh = {};
+   wh.type = WINSYS_HANDLE_TYPE_FD;
+   wh.handle = pb->share;
+   wh.stride = align(width * 4, 64);
+   wh.modifier = DRM_FORMAT_MOD_LINEAR;
+   pb->res = screen->resource_from_handle(screen, &t, &wh,
+                                          PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+   if (!pb->res) {
+      debug_printf("fd_wgl: pbuffer resource_from_handle %ux%u that bai\n",
+                   width, height);
+      delete pb;
+      return NULL;
+   }
+
+   pb->base.destroy = fd_wgl_pbuffer_destroy;
+   pb->base.resize = fd_wgl_pbuffer_resize;
+   pb->base.present = fd_wgl_pbuffer_present;
+   pb->base.get_resource = fd_wgl_pbuffer_get_resource;
+   pb->base.flush_frontbuffer = fd_wgl_pbuffer_flush_frontbuffer;
+   pb->base.get_share_handle = fd_wgl_pbuffer_get_share_handle;
+   return &pb->base;
+}
