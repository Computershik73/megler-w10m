+#ifdef STW_COREWINDOW
+bool
+stw_shared_pbuffer_supported(void)
+{
+   return stw_dev && stw_dev->stw_winsys->create_shared_pbuffer &&
+          stw_dev->stw_winsys->query_shared_texture;
+}
+
+bool
+stw_query_shared_texture(HANDLE share_handle, unsigned *width,
+                         unsigned *height, int *format)
+{
+   enum pipe_format pf = PIPE_FORMAT_NONE;
+   if (!stw_shared_pbuffer_supported() ||
+       !stw_dev->stw_winsys->query_shared_texture(share_handle, width, height,
+                                                  &pf))
+      return false;
+   *format = pf == PIPE_FORMAT_B8G8R8A8_UNORM ? 1 :
+             pf == PIPE_FORMAT_R8G8B8A8_UNORM ? 2 : 0;
+   return true;
+}
+
+struct stw_framebuffer *
+stw_pbuffer_create_shared(const struct stw_pixelformat_info *pfi,
+                          HANDLE share_handle, int width, int height,
+                          struct pipe_frontend_screen *fscreen)
+{
+   if (!stw_shared_pbuffer_supported() || width <= 0 || height <= 0)
+      return NULL;
+
+   /* Format resource = thu tu kenh cua texture x alpha cua config. */
+   bool alpha = util_format_has_alpha(pfi->stvis.color_format);
+   enum pipe_format format =
+      alpha ? PIPE_FORMAT_B8G8R8A8_UNORM : PIPE_FORMAT_B8G8R8X8_UNORM;
+   if (share_handle) {
+      unsigned w, h;
+      int tf;
+      if (!stw_query_shared_texture(share_handle, &w, &h, &tf) || !tf ||
+          w != (unsigned)width || h != (unsigned)height)
+         return NULL;
+      if (tf == 2)
+         format = alpha ? PIPE_FORMAT_R8G8B8A8_UNORM
+                        : PIPE_FORMAT_R8G8B8X8_UNORM;
+   }
+
+   struct stw_winsys_framebuffer *wsfb =
+      stw_dev->stw_winsys->create_shared_pbuffer(stw_dev->screen, share_handle,
+                                                 width, height, format);
+   if (!wsfb)
+      return NULL;
+
+   struct stw_framebuffer *fb = stw_pbuffer_create(pfi, width, height, fscreen);
+   if (!fb) {
+      wsfb->destroy(wsfb, NULL);
+      return NULL;
+   }
+   assert(!fb->winsys_framebuffer);
+   fb->winsys_framebuffer = wsfb;
+   return fb;
+}
+
+HANDLE
+stw_framebuffer_get_share_handle(struct stw_framebuffer *fb)
+{
+   struct stw_winsys_framebuffer *ws = fb ? fb->winsys_framebuffer : NULL;
+   return ws && ws->get_share_handle ? ws->get_share_handle(ws) : NULL;
+}
+#endif /* STW_COREWINDOW */
