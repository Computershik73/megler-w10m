-   if (surf->Type != EGL_WINDOW_BIT)
+   if (surf->Type != EGL_WINDOW_BIT) {
+      /* ANGLE share handle: swap pbuffer = flush + cho de D3D doc. */
+      if (surf->Type == EGL_PBUFFER_BIT &&
+          disp->Extensions.ANGLE_surface_d3d_texture_2d_share_handle) {
+         egl_relax (disp, &surf->Resource) {
+            ret = disp->Driver->SwapBuffers(disp, surf);
+         }
+         RETURN_EGL_EVAL(disp, ret);
+      }
       RETURN_EGL_EVAL(disp, EGL_TRUE);
+   }
 
    /* From the EGL 1.5 spec:
     *
@@ -1790,6 +1802,26 @@ eglCreatePbufferFromClientBuffer(EGLDisplay dpy, EGLenum buftype,
 
    _EGL_CHECK_CONFIG(disp, conf, EGL_NO_SURFACE);
 
+   if (buftype == EGL_D3D_TEXTURE_2D_SHARE_HANDLE_ANGLE &&
+       disp->Extensions.ANGLE_d3d_share_handle_client_buffer &&
+       disp->Driver->CreatePbufferFromClientBuffer) {
+      _EGLSurface *surf = NULL;
+      EGLSurface ret;
+
+      if ((conf->SurfaceType & EGL_PBUFFER_BIT) == 0)
+         RETURN_EGL_ERROR(disp, EGL_BAD_MATCH, EGL_NO_SURFACE);
+      if (!buffer)
+         RETURN_EGL_ERROR(disp, EGL_BAD_PARAMETER, EGL_NO_SURFACE);
+
+      egl_relax (disp) {
+         surf = disp->Driver->CreatePbufferFromClientBuffer(
+            disp, buftype, buffer, conf, attrib_list);
+      }
+      ret = (surf) ? _eglLinkSurface(surf) : EGL_NO_SURFACE;
+
+      RETURN_EGL_EVAL(disp, ret);
+   }
+
    /* OpenVG is not supported */
    RETURN_EGL_ERROR(disp, EGL_BAD_ALLOC, EGL_NO_SURFACE);
 }
@@ -2377,6 +2409,33 @@ eglGetMscRateANGLE(EGLDisplay dpy, EGLSurface surface, EGLint *numerator,
    RETURN_EGL_EVAL(disp, ret);
 }
 
+static EGLBoolean EGLAPIENTRY
+eglQuerySurfacePointerANGLE(EGLDisplay dpy, EGLSurface surface,
+                            EGLint attribute, void **value)
+{
+   _EGLDisplay *disp = _eglLockDisplay(dpy);
+   _EGLSurface *surf = _eglLookupSurface(surface, disp);
+   EGLBoolean ret;
+
+   _EGL_FUNC_START(disp, EGL_OBJECT_SURFACE_KHR, surf);
+
+   _EGL_CHECK_SURFACE(disp, surf, EGL_FALSE);
+   if (!disp->Extensions.ANGLE_query_surface_pointer ||
+       !disp->Driver->QuerySurfacePointerANGLE)
+      RETURN_EGL_ERROR(disp, EGL_BAD_ACCESS, EGL_FALSE);
+
+   if (!value)
+      RETURN_EGL_ERROR(disp, EGL_BAD_PARAMETER, EGL_FALSE);
+
+   if (attribute != EGL_D3D_TEXTURE_2D_SHARE_HANDLE_ANGLE ||
+       !disp->Extensions.ANGLE_surface_d3d_texture_2d_share_handle)
+      RETURN_EGL_ERROR(disp, EGL_BAD_ATTRIBUTE, EGL_FALSE);
+
+   ret = disp->Driver->QuerySurfacePointerANGLE(disp, surf, attribute, value);
+
+   RETURN_EGL_EVAL(disp, ret);
+}
