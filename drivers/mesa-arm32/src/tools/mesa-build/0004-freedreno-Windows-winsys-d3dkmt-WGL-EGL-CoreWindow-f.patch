--- /dev/null
+++ b/src/gallium/winsys/freedreno/d3dkmt/fd_d3dkmt_winsys.c
@@ -0,0 +1,34 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "fd_d3dkmt_public.h"
+
+#include "util/u_debug.h"
+#include "util/u_inlines.h"
+
+#include "freedreno/freedreno_screen.h"
+#include "drm/freedreno_drmif.h"
+#include "drm/d3dkmt/fd_kmt.h"
+
+struct pipe_screen *
+fd_d3dkmt_screen_create(const struct pipe_screen_config *config)
+{
+   struct fd_kmt *kmt = NULL;
+   int ret = fd_kmt_open(&kmt);
+   if (ret || !kmt) {
+      debug_printf("freedreno/d3dkmt: fd_kmt_open failed: %d\n", ret);
+      return NULL;
+   }
+
+   /* fd_device so huu kmt tu day. */
+   struct fd_device *dev = fd_device_new_d3dkmt(kmt);
+   if (!dev) {
+      debug_printf("freedreno/d3dkmt: fd_device_new_d3dkmt failed\n");
+      fd_kmt_close(kmt);
+      return NULL;
+   }
+
+   return fd_screen_create_dev(dev, config, NULL);
+}
