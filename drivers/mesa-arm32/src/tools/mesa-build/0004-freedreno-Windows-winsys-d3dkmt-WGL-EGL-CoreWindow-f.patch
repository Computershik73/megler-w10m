diff --git a/src/gallium/winsys/freedreno/d3dkmt/fd_wgl_framebuffer.cpp b/src/gallium/winsys/freedreno/d3dkmt/fd_wgl_framebuffer.cpp
new file mode 100644
index 0000000..7879031
--- /dev/null
+++ b/src/gallium/winsys/freedreno/d3dkmt/fd_wgl_framebuffer.cpp
@@ -0,0 +1,282 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ *
+ * stw_winsys_framebuffer cho Windows 10 Mobile: "HWND" la CoreWindow*.
+ *
+ * Phien ban 1 (don gian, cham): freedreno render vao pipe_resource rieng;
+ * khi present doc ra bang texture_map roi UpdateSubresource vao back buffer
+ * cua swapchain D3D11 (CreateSwapChainForCoreWindow) va Present.
+ * Toi uu sau: allocation dung chung giua freedreno va DXGI (khong copy CPU).
+ */
+
+#include "fd_d3dkmt_public.h"
+
+#include <new>
+
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi1_2.h>
+#include <wrl/client.h>
+#include <roapi.h>
+/* SDK 16299 winrt headers dung DEPRECATEDENUMERATOR chi dinh nghia cho MIDL moi. */
+#ifndef DEPRECATEDENUMERATOR
+#define DEPRECATEDENUMERATOR(x)
+#endif
+#include <windows.foundation.h>
+#include <windows.ui.core.h>
+#include <windows.graphics.display.h>
+#include <wrl/wrappers/corewrappers.h>
+
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "util/format/u_format.h"
+#include "util/u_debug.h"
+#include "util/box.h"
+#include "util/u_inlines.h"
+#include "frontend/api.h"
+
+#include "stw_winsys.h"
+
+using Microsoft::WRL::ComPtr;
+namespace WUC = ABI::Windows::UI::Core;
+namespace WGD = ABI::Windows::Graphics::Display;
+
+struct fd_wgl_framebuffer {
+   struct stw_winsys_framebuffer base;
+
+   struct pipe_screen *screen;
+   IUnknown *core_window;               /* khong so huu */
+
+   ComPtr<ID3D11Device> d3d;
+   ComPtr<ID3D11DeviceContext> d3dctx;
+   ComPtr<IDXGISwapChain1> swapchain;
+   DXGI_FORMAT dxgi_format;
+
+   struct pipe_context *ctx;            /* context GL dang ve (tu resize) */
+   struct pipe_resource *color;         /* render target cua freedreno */
+};
+
+static fd_wgl_framebuffer *
+fd_wgl_fb(struct stw_winsys_framebuffer *fb)
+{
+   return (fd_wgl_framebuffer *)fb;
+}
+
+static float
+current_view_scale(void)
+{
+   ComPtr<WGD::IDisplayInformationStatics> statics;
+   HRESULT hr = RoGetActivationFactory(
+      Microsoft::WRL::Wrappers::HStringReference(
+         RuntimeClass_Windows_Graphics_Display_DisplayInformation).Get(),
+      IID_PPV_ARGS(&statics));
+   if (FAILED(hr))
+      return 1.0f;
+
+   ComPtr<WGD::IDisplayInformation> info;
+   if (FAILED(statics->GetForCurrentView(&info)) || !info)
+      return 1.0f;
+
+   ComPtr<WGD::IDisplayInformation2> info2;
+   double scale = 1.0;
+   if (SUCCEEDED(info.As(&info2)) &&
+       SUCCEEDED(info2->get_RawPixelsPerViewPixel(&scale)) && scale > 0.0)
+      return (float)scale;
+   return 1.0f;
+}
+
+extern "C" bool
+fd_wgl_get_window_size(HWND hwnd, unsigned *width, unsigned *height)
+{
+   if (!hwnd)
+      return false;
+
+   ComPtr<WUC::ICoreWindow> window;
+   if (FAILED(((IUnknown *)hwnd)->QueryInterface(IID_PPV_ARGS(&window))))
+      return false;
+
+   ABI::Windows::Foundation::Rect bounds;
+   if (FAILED(window->get_Bounds(&bounds)))
+      return false;
+
+   float scale = current_view_scale();
+   *width = (unsigned)(bounds.Width * scale + 0.5f);
+   *height = (unsigned)(bounds.Height * scale + 0.5f);
+   return *width && *height;
+}
+
+static DXGI_FORMAT
+to_dxgi_format(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_R8G8B8X8_UNORM:
+      return DXGI_FORMAT_R8G8B8A8_UNORM;
+   case PIPE_FORMAT_B5G6R5_UNORM:
+      return DXGI_FORMAT_B5G6R5_UNORM;
+   default:
+      return DXGI_FORMAT_B8G8R8A8_UNORM;
+   }
+}
+
+static void
+fd_wgl_framebuffer_destroy(struct stw_winsys_framebuffer *pfb,
+                           struct pipe_context *ctx)
+{
+   fd_wgl_framebuffer *fb = fd_wgl_fb(pfb);
+   (void)ctx;
+   pipe_resource_reference(&fb->color, NULL);
+   delete fb;
+}
+
+static void
+fd_wgl_framebuffer_resize(struct stw_winsys_framebuffer *pfb,
+                          struct pipe_context *ctx,
+                          struct pipe_resource *templ)
+{
+   fd_wgl_framebuffer *fb = fd_wgl_fb(pfb);
+
+   fb->ctx = ctx;
+   pipe_resource_reference(&fb->color, NULL);
+
+   struct pipe_resource t = *templ;
+   t.target = PIPE_TEXTURE_2D;
+   t.bind |= PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+   t.usage = PIPE_USAGE_DEFAULT;
+   t.depth0 = t.array_size = 1;
+   t.last_level = 0;
+   fb->color = fb->screen->resource_create(fb->screen, &t);
+   if (!fb->color) {
+      debug_printf("fd_wgl: resource_create %ux%u failed\n", t.width0,
+                   t.height0);
+      return;
+   }
+
+   fb->dxgi_format = to_dxgi_format(templ->format);
+
+   if (!fb->swapchain) {
+      ComPtr<IDXGIDevice> dxgi_dev;
+      ComPtr<IDXGIAdapter> adapter;
+      ComPtr<IDXGIFactory2> factory;
+      if (FAILED(fb->d3d.As(&dxgi_dev)) ||
+          FAILED(dxgi_dev->GetAdapter(&adapter)) ||
+          FAILED(adapter->GetParent(IID_PPV_ARGS(&factory)))) {
+         debug_printf("fd_wgl: khong lay duoc IDXGIFactory2\n");
+         return;
+      }
+
+      DXGI_SWAP_CHAIN_DESC1 desc = {};
+      desc.Width = t.width0;
+      desc.Height = t.height0;
+      desc.Format = fb->dxgi_format;
+      desc.SampleDesc.Count = 1;
+      desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+      desc.BufferCount = 2;
+      desc.Scaling = DXGI_SCALING_STRETCH;
+      desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+      desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+
+      HRESULT hr = factory->CreateSwapChainForCoreWindow(
+         fb->d3d.Get(), fb->core_window, &desc, nullptr, &fb->swapchain);
+      if (FAILED(hr)) {
+         debug_printf("fd_wgl: CreateSwapChainForCoreWindow 0x%08lx\n",
+                      (unsigned long)hr);
+         return;
+      }
+   } else {
+      HRESULT hr = fb->swapchain->ResizeBuffers(2, t.width0, t.height0,
+                                                fb->dxgi_format, 0);
+      if (FAILED(hr))
+         debug_printf("fd_wgl: ResizeBuffers 0x%08lx\n", (unsigned long)hr);
+   }
+}
+
+static struct pipe_resource *
+fd_wgl_framebuffer_get_resource(struct stw_winsys_framebuffer *pfb,
+                                enum st_attachment_type statt)
+{
+   fd_wgl_framebuffer *fb = fd_wgl_fb(pfb);
+   (void)statt; /* back/front dung chung mot buffer: present la copy */
+   if (!fb->color)
+      return NULL;
+   pipe_reference(NULL, &fb->color->reference);
+   return fb->color;
+}
+
+static bool
+fd_wgl_framebuffer_present(struct stw_winsys_framebuffer *pfb, int interval)
+{
+   fd_wgl_framebuffer *fb = fd_wgl_fb(pfb);
+   if (!fb->swapchain || !fb->color || !fb->ctx)
+      return false;
+
+   struct pipe_context *ctx = fb->ctx;
+   struct pipe_resource *res = fb->color;
+   struct pipe_box box;
+   u_box_2d(0, 0, res->width0, res->height0, &box);
+
+   struct pipe_transfer *xfer = NULL;
+   /* texture_map READ tu flush + cho GPU va detile neu can. */
+   void *ptr = ctx->texture_map(ctx, res, 0, PIPE_MAP_READ, &box, &xfer);
+   if (!ptr)
+      return false;
+
+   ComPtr<ID3D11Texture2D> back;
+   if (SUCCEEDED(fb->swapchain->GetBuffer(0, IID_PPV_ARGS(&back))))
+      fb->d3dctx->UpdateSubresource(back.Get(), 0, nullptr, ptr,
+                                    xfer->stride, 0);
+
+   ctx->texture_unmap(ctx, xfer);
+
+   HRESULT hr = fb->swapchain->Present(interval > 0 ? 1 : 0, 0);
+   return SUCCEEDED(hr);
+}
+
+static void
+fd_wgl_framebuffer_flush_frontbuffer(struct stw_winsys_framebuffer *pfb,
+                                     struct pipe_context *ctx)
+{
+   fd_wgl_framebuffer *fb = fd_wgl_fb(pfb);
+   fb->ctx = ctx;
+   fd_wgl_framebuffer_present(pfb, 0);
+}
+
+extern "C" struct stw_winsys_framebuffer *
+fd_wgl_create_framebuffer(struct pipe_screen *screen, HWND hwnd,
+                          int iPixelFormat)
+{
+   (void)iPixelFormat;
+   if (!hwnd)
+      return NULL;
+
+   fd_wgl_framebuffer *fb = new (std::nothrow) fd_wgl_framebuffer();
+   if (!fb)
+      return NULL;
+
+   fb->screen = screen;
+   fb->core_window = (IUnknown *)hwnd;
+
+   static const D3D_FEATURE_LEVEL levels[] = {
+      D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0,
+      D3D_FEATURE_LEVEL_10_1, D3D_FEATURE_LEVEL_10_0,
+      D3D_FEATURE_LEVEL_9_3,  D3D_FEATURE_LEVEL_9_1,
+   };
+   HRESULT hr = D3D11CreateDevice(
+      nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+      D3D11_CREATE_DEVICE_BGRA_SUPPORT, levels, ARRAYSIZE(levels),
+      D3D11_SDK_VERSION, &fb->d3d, nullptr, &fb->d3dctx);
+   if (FAILED(hr)) {
+      debug_printf("fd_wgl: D3D11CreateDevice 0x%08lx\n", (unsigned long)hr);
+      delete fb;
+      return NULL;
+   }
+
+   fb->base.destroy = fd_wgl_framebuffer_destroy;
+   fb->base.resize = fd_wgl_framebuffer_resize;
+   fb->base.present = fd_wgl_framebuffer_present;
+   fb->base.get_resource = fd_wgl_framebuffer_get_resource;
+   fb->base.flush_frontbuffer = fd_wgl_framebuffer_flush_frontbuffer;
+
+   return &fb->base;
+}
