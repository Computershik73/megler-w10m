+/* Giong pipe-loader: option gallium chung + option rieng cua freedreno. */
+static const driOptionDescription fd_d3dkmt_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "freedreno/driinfo_freedreno.h"
+};
+
+static driOptionCache fd_option_info;
+static driOptionCache fd_option_cache;
+
 struct pipe_screen *
 fd_d3dkmt_screen_create(const struct pipe_screen_config *config)
 {
+   struct pipe_screen_config local_config;
+
+   if (!config) {
+      /* WGL/EGL tren Windows khong qua pipe-loader: tu dung driconf. */
+      static bool parsed;
+      if (!parsed) {
+         driParseOptionInfo(&fd_option_info, fd_d3dkmt_driconf,
+                            ARRAY_SIZE(fd_d3dkmt_driconf));
+         driParseConfigFiles(&fd_option_cache, &fd_option_info,
+                             &(driConfigFileParseParams){
+                                .driverName = "msm",
+                             });
+         parsed = true;
+      }
+      local_config.driver_name_is_inferred = false;
+      local_config.options = &fd_option_cache;
+      local_config.options_info = &fd_option_info;
+      config = &local_config;
+   }
+
    struct fd_kmt *kmt = NULL;
    int ret = fd_kmt_open(&kmt);
    if (ret || !kmt) {
