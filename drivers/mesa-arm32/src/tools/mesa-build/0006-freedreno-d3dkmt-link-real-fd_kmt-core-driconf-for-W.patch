@@ -121,9 +121,78 @@ wgl_screen_create_by_name(HDC hDC, const char* driver, struct sw_winsys *winsys)
 static bool use_freedreno = false;
 #endif
 
+#ifdef STW_COREWINDOW
+#include <signal.h>
+#include <stdio.h>
+/* /MT: moi module co CRT rieng. Handler nay in backtrace (module+offset) khi CRT
+ * gap tham so sai (vd fopen tra NULL roi fprintf) - neu khong process chet im
+ * lang (__fastfail). Map offset bang llvm-symbolizer + .pdb.
+ */
+static void
+wgl_dump_backtrace(const char *why, void *const *frames, USHORT n);
+
+static void
+wgl_invalid_parameter(const wchar_t *expr, const wchar_t *func,
+                      const wchar_t *file, unsigned line, uintptr_t reserved)
+{
+   void *frames[24];
+   USHORT n = RtlCaptureStackBackTrace(0, 24, frames, NULL);
+   wgl_dump_backtrace("CRT invalid parameter", frames, n);
+   abort();
+}
+
+static void
+wgl_on_abort(int sig)
+{
+   void *frames[24];
+   USHORT n = RtlCaptureStackBackTrace(0, 24, frames, NULL);
+   wgl_dump_backtrace("SIGABRT", frames, n);
+}
+
+static LONG WINAPI
+wgl_veh(EXCEPTION_POINTERS *ep)
+{
+   DWORD code = ep->ExceptionRecord->ExceptionCode;
+   /* bo qua exception "binh thuong" (debug print, C++ throw, thread name) */
+   if (code == 0x40010006 || code == 0x4001000A || code == 0xE06D7363 ||
+       code == 0x406D1388)
+      return EXCEPTION_CONTINUE_SEARCH;
+   void *frames[24];
+   frames[0] = ep->ExceptionRecord->ExceptionAddress;
+   USHORT n = 1 + RtlCaptureStackBackTrace(0, 23, frames + 1, NULL);
+   char why[64];
+   snprintf(why, sizeof(why), "exception 0x%08lx", (unsigned long)code);
+   wgl_dump_backtrace(why, frames, n);
+   return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static void
+wgl_dump_backtrace(const char *why, void *const *frames, USHORT n)
+{
+   fprintf(stderr, "MESA: %s, backtrace:\n", why);
+   for (USHORT i = 0; i < n; i++) {
+      HMODULE mod = NULL;
+      char name[MAX_PATH] = "?";
+      if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                             (LPCSTR)frames[i], &mod))
+         GetModuleFileNameA(mod, name, sizeof(name));
+      const char *base = strrchr(name, '\\');
+      fprintf(stderr, "  #%u %s+0x%x\n", i, base ? base + 1 : name,
+              (unsigned)((uintptr_t)frames[i] - (uintptr_t)mod));
+   }
+   fflush(stderr);
+}
+#endif
+
 static struct pipe_screen *
 wgl_screen_create(HDC hDC)
 {
+#ifdef STW_COREWINDOW
+   _set_invalid_parameter_handler(wgl_invalid_parameter);
+   signal(SIGABRT, wgl_on_abort);
+   AddVectoredExceptionHandler(1, wgl_veh);
+#endif
 #ifdef GALLIUM_FREEDRENO
