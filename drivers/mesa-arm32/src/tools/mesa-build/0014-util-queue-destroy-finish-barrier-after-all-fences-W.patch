From 6feb5c180220358a57bf401257823f0754b26dc8 Mon Sep 17 00:00:00 2001
From: anon <>
Date: Thu, 19 Nov 2026 00:23:24 +0700
Subject: [PATCH 14/15] util/queue: destroy finish barrier after all fences
 (Windows barrier fallback UAF)

---
 src/util/u_queue.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/util/u_queue.c b/src/util/u_queue.c
index 1ebdfdb..38e2134 100644
--- a/src/util/u_queue.c
+++ b/src/util/u_queue.c
@@ -520,8 +520,12 @@ static void
 util_queue_finish_execute(void *data, void *gdata, int num_thread)
 {
    util_barrier *barrier = data;
-   if (util_barrier_wait(barrier))
-      util_barrier_destroy(barrier);
+   /* Destroyed by util_queue_finish() once every fence has signalled. The
+    * mutex/condvar fallback (Windows) returns true from every waiter, so
+    * destroying here freed the barrier while other threads were still
+    * reacquiring its mutex in cnd_wait (AV on Windows ARM).
+    */
+   util_barrier_wait(barrier);
 }
 
 void
@@ -734,6 +738,7 @@ util_queue_finish(struct util_queue *queue)
       util_queue_fence_wait(&fences[i]);
       util_queue_fence_destroy(&fences[i]);
    }
+   util_barrier_destroy(&barrier);
    simple_mtx_unlock(&queue->finish_lock);
 
    free(fences);
-- 
2.35.1.windows.2

