diff --git a/src/freedreno/drm/d3dkmt/d3dkmt_ringbuffer_sp.c b/src/freedreno/drm/d3dkmt/d3dkmt_ringbuffer_sp.c
new file mode 100644
index 0000000..f5f906c
--- /dev/null
+++ b/src/freedreno/drm/d3dkmt/d3dkmt_ringbuffer_sp.c
@@ -0,0 +1,92 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ *
+ * Gom cac deferred submit (nhu msm_ringbuffer_sp.c) roi goi fd_kmt_submit().
+ */
+
+#include "drm/freedreno_ringbuffer_sp.h"
+#include "d3dkmt_priv.h"
+
+static int
+flush_submit_list(struct list_head *submit_list)
+{
+   struct fd_submit_sp *fd_submit = to_fd_submit_sp(last_submit(submit_list));
+   struct fd_pipe *pipe = fd_submit->base.pipe;
+   unsigned nr_cmds = 0;
+   int ret;
+
+   MESA_TRACE_FUNC();
+
+   foreach_submit (submit, submit_list)
+      nr_cmds += to_fd_ringbuffer_sp(submit->primary)->u.nr_cmds;
+
+   struct fd_kmt_cmd *cmds = calloc(MAX2(nr_cmds, 1), sizeof(*cmds));
+   if (!cmds)
+      return -ENOMEM;
+
+   unsigned cmd_idx = 0;
+
+   foreach_submit_safe (submit, submit_list) {
+      struct fd_ringbuffer_sp *primary = to_fd_ringbuffer_sp(submit->primary);
+
+      for (unsigned i = 0; i < primary->u.nr_cmds; i++) {
+         struct fd_bo *ring_bo = primary->u.cmds[i].ring_bo;
+         fd_submit_append_bo(fd_submit, ring_bo);
+         cmds[cmd_idx].iova = fd_bo_get_iova(ring_bo) + primary->offset;
+         cmds[cmd_idx].size_dw = primary->u.cmds[i].size / 4;
+         cmds[cmd_idx].handle = suballoc_bo(ring_bo) ?
+            fd_bo_heap_block(ring_bo)->handle : ring_bo->handle;
+         cmd_idx++;
+      }
+
+      if (submit == last_submit(submit_list))
+         break;
+
+      struct fd_submit_sp *deferred = to_fd_submit_sp(submit);
+      for (unsigned i = 0; i < deferred->nr_bos; i++)
+         fd_submit_append_bo(fd_submit, deferred->bos[i]);
+
+      list_del(&submit->node);
+      fd_submit_del(submit);
+   }
+
+   struct fd_kmt_bo_ref *bos =
+      calloc(MAX2(fd_submit->nr_bos, 1), sizeof(*bos));
+   if (!bos) {
+      free(cmds);
+      return -ENOMEM;
+   }
+
+   for (unsigned i = 0; i < fd_submit->nr_bos; i++) {
+      uint32_t rf = fd_submit->bos[i]->reloc_flags;
+      bos[i].handle = fd_submit->bos[i]->handle;
+      bos[i].flags = ((rf & FD_RELOC_READ) ? FD_KMT_PREP_READ : 0) |
+                     ((rf & FD_RELOC_WRITE) ? FD_KMT_PREP_WRITE : 0);
+   }
+
+   uint32_t fence = 0;
+   ret = fd_kmt_submit(to_kmt(pipe->dev), cmds, nr_cmds, bos,
+                       fd_submit->nr_bos, &fence);
+   if (ret) {
+      ERROR_MSG("fd_kmt_submit failed: %d (nr_cmds=%u nr_bos=%u)", ret,
+                nr_cmds, fd_submit->nr_bos);
+   } else {
+      fd_submit->out_fence->kfence = fence;
+      fd_submit->out_fence->fence_fd = -1;
+   }
+
+   free(bos);
+   free(cmds);
+
+   /* Chua ho tro sync-file fd tren Windows. */
+   fd_submit->in_fence_fd = -1;
+
+   return ret;
+}
+
+struct fd_submit *
+d3dkmt_submit_sp_new(struct fd_pipe *pipe)
+{
+   return fd_submit_sp_new(pipe, flush_submit_list);
+}
diff --git a/src/freedreno/drm/d3dkmt/fd_kmt.h b/src/freedreno/drm/d3dkmt/fd_kmt.h
new file mode 100644
index 0000000..db9e670
--- /dev/null
+++ b/src/freedreno/drm/d3dkmt/fd_kmt.h
@@ -0,0 +1,121 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ *
+ * fd_kmt: giao dien giua backend freedreno d3dkmt (Mesa) va LOI D3DKMT
+ * (do nguoi dung tu viet, nam ngoai Mesa).
+ *
+ * Mesa chi goi cac ham fd_kmt_* duoi day; moi chi tiet WDDM (D3DKMTOpenAdapter*,
+ * CreateDevice, CreateContextVirtual, CreateAllocation2, MakeResident/paging
+ * queue, MapGpuVirtualAddress, Lock2/Unlock2, SubmitCommand, sync object /
+ * monitored fence, private driver data cho qcdxkm8996) nam o phia loi.
+ *
+ * Quy uoc:
+ *  - Ham tra ve int: 0 = thanh cong, < 0 = -errno (vd -ENOMEM, -ETIMEDOUT,
+ *    -ENOSYS khi chua cai dat).
+ *  - Thread-safety: Mesa co the goi tu nhieu thread (submit queue rieng).
+ *    Loi phai tu bao ve trang thai noi bo.
+ *  - "handle" la D3DKMT_HANDLE cua allocation (khac 0 neu hop le).
+ *  - iova la GPU VA (D3DGPU_VIRTUAL_ADDRESS) da map, on dinh suot doi BO.
+ *
+ * Mesa khong bao gio goi D3DKMT truc tiep.
+ */
+
+#ifndef FD_KMT_H_
+#define FD_KMT_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct fd_kmt;
+
+/* ------------------------------------------------------------------ */
+/* Phien / adapter                                                     */
+/* ------------------------------------------------------------------ */
+
+struct fd_kmt_info {
+   uint32_t gpu_id;     /* vd 530 */
+   uint64_t chip_id;    /* dang 0xCCRRPPSS: core,major,minor,patch (vd 0x05030000 + patch) */
+   uint64_t gmem_base;  /* dia chi GMEM theo quan diem GPU */
+   uint32_t gmem_size;  /* byte; Adreno 530 = 1 MiB */
+   uint64_t va_size;    /* kich thuoc khong gian GPU VA cua process */
+   uint32_t nr_priorities;
+};
+
+/* Mo adapter Adreno, tao device + context 3D + paging queue. */
+int fd_kmt_open(struct fd_kmt **out_kmt);
+void fd_kmt_close(struct fd_kmt *kmt);
+int fd_kmt_get_info(struct fd_kmt *kmt, struct fd_kmt_info *info);
+/* Timestamp GPU (always-on counter), dung cho FD_TIMESTAMP. */
+int fd_kmt_get_timestamp(struct fd_kmt *kmt, uint64_t *ts);
+
+/* ------------------------------------------------------------------ */
+/* Allocation (BO)                                                     */
+/* ------------------------------------------------------------------ */
+
+enum fd_kmt_bo_flags {
+   FD_KMT_BO_CACHED     = 1u << 0, /* CPU cached (coherent neu co) */
+   FD_KMT_BO_GPU_READONLY = 1u << 1,
+   FD_KMT_BO_NOMAP      = 1u << 2, /* CPU khong can map */
+   FD_KMT_BO_SCANOUT    = 1u << 3,
+   FD_KMT_BO_SHARED     = 1u << 4,
+   FD_KMT_BO_RING       = 1u << 5, /* chua command stream */
+};
+
+/* Cap phat + lam resident + map GPU VA. Tra handle va iova. */
+int fd_kmt_bo_alloc(struct fd_kmt *kmt, uint64_t size, uint32_t flags,
+                    uint32_t *out_handle, uint64_t *out_iova);
+void fd_kmt_bo_free(struct fd_kmt *kmt, uint32_t handle);
+
+/* Map CPU (Lock2). Con tro on dinh toi fd_kmt_bo_free(). */
+int fd_kmt_bo_map(struct fd_kmt *kmt, uint32_t handle, void **out_ptr);
+
+/* Cho BO roi (GPU khong con doc/ghi). op = FD_KMT_PREP_*.
+ * timeout_ns = 0: chi kiem tra (tra -EBUSY neu dang ban).
+ */
+enum {
+   FD_KMT_PREP_READ  = 1u << 0,
+   FD_KMT_PREP_WRITE = 1u << 1,
+};
+int fd_kmt_bo_wait(struct fd_kmt *kmt, uint32_t handle, uint32_t op,
+                   uint64_t timeout_ns);
+
+/* ------------------------------------------------------------------ */
+/* Submit / fence                                                      */
+/* ------------------------------------------------------------------ */
+
+/* Mot IB (indirect buffer) PM4 trong mot BO. */
+struct fd_kmt_cmd {
+   uint64_t iova;      /* GPU VA bat dau IB */
+   uint32_t size_dw;   /* so dword */
+   uint32_t handle;    /* BO chua IB */
+};
+
+/* Mot BO duoc submit tham chieu. */
+struct fd_kmt_bo_ref {
+   uint32_t handle;
+   uint32_t flags;     /* FD_KMT_PREP_READ / FD_KMT_PREP_WRITE */
+};
+
+/* Gui danh sach IB len context 3D. out_fence: so fence tang dan (seqno)
+ * de dung voi fd_kmt_fence_wait().
+ */
+int fd_kmt_submit(struct fd_kmt *kmt,
+                  const struct fd_kmt_cmd *cmds, uint32_t nr_cmds,
+                  const struct fd_kmt_bo_ref *bos, uint32_t nr_bos,
+                  uint32_t *out_fence);
+
+/* Cho fence <= fence hoan tat. timeout_ns = UINT64_MAX: vo han.
+ * Tra -ETIMEDOUT khi het han.
+ */
+int fd_kmt_fence_wait(struct fd_kmt *kmt, uint32_t fence, uint64_t timeout_ns);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* FD_KMT_H_ */
