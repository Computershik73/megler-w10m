diff --git a/src/freedreno/drm/d3dkmt/d3dkmt_bo.c b/src/freedreno/drm/d3dkmt/d3dkmt_bo.c
new file mode 100644
index 0000000..c4fa77d
--- /dev/null
+++ b/src/freedreno/drm/d3dkmt/d3dkmt_bo.c
@@ -0,0 +1,135 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "d3dkmt_priv.h"
+
+static int
+d3dkmt_bo_offset(struct fd_bo *bo, uint64_t *offset)
+{
+   /* Khong co mmap-offset tren Windows; map qua ->map. */
+   (void)bo;
+   *offset = 0;
+   return -ENOSYS;
+}
+
+static void *
+d3dkmt_bo_map(struct fd_bo *bo)
+{
+   void *ptr = NULL;
+   int ret = fd_kmt_bo_map(to_kmt(bo->dev), bo->handle, &ptr);
+   if (ret) {
+      ERROR_MSG("fd_kmt_bo_map failed: %d", ret);
+      return MAP_FAILED;
+   }
+   return ptr;
+}
+
+static int
+d3dkmt_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
+{
+   uint32_t kop = 0;
+   (void)pipe;
+   if (op & FD_BO_PREP_READ)
+      kop |= FD_KMT_PREP_READ;
+   if (op & FD_BO_PREP_WRITE)
+      kop |= FD_KMT_PREP_WRITE;
+   uint64_t timeout = (op & FD_BO_PREP_NOSYNC) ? 0 : UINT64_MAX;
+   return fd_kmt_bo_wait(to_kmt(bo->dev), bo->handle, kop, timeout);
+}
+
+static int
+d3dkmt_bo_madvise(struct fd_bo *bo, int willneed)
+{
+   /* Chua dung Offer/Reclaim: coi nhu BO luon con noi dung. */
+   (void)bo;
+   return willneed;
+}
+
+static uint64_t
+d3dkmt_bo_iova(struct fd_bo *bo)
+{
+   return to_d3dkmt_bo(bo)->gpu_va;
+}
+
+static void
+d3dkmt_bo_set_name(struct fd_bo *bo, const char *fmt, va_list ap)
+{
+   (void)bo; (void)fmt; (void)ap;
+}
+
+static int
+d3dkmt_bo_dmabuf(struct fd_bo *bo)
+{
+   (void)bo;
+   return -ENOSYS;
+}
+
+static const struct fd_bo_funcs funcs = {
+   .offset = d3dkmt_bo_offset,
+   .map = d3dkmt_bo_map,
+   .cpu_prep = d3dkmt_bo_cpu_prep,
+   .madvise = d3dkmt_bo_madvise,
+   .iova = d3dkmt_bo_iova,
+   .set_name = d3dkmt_bo_set_name,
+   .dmabuf = d3dkmt_bo_dmabuf,
+   .destroy = fd_bo_fini_common,
+};
+
+static uint32_t
+to_kmt_flags(uint32_t flags)
+{
+   uint32_t f = 0;
+   if (flags & FD_BO_CACHED_COHERENT)
+      f |= FD_KMT_BO_CACHED;
+   if (flags & FD_BO_GPUREADONLY)
+      f |= FD_KMT_BO_GPU_READONLY;
+   if (flags & FD_BO_NOMAP)
+      f |= FD_KMT_BO_NOMAP;
+   if (flags & FD_BO_SCANOUT)
+      f |= FD_KMT_BO_SCANOUT;
+   if (flags & FD_BO_SHARED)
+      f |= FD_KMT_BO_SHARED;
+   if (flags & FD_BO_HINT_COMMAND)
+      f |= FD_KMT_BO_RING;
+   return f;
+}
+
+struct fd_bo *
+d3dkmt_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags)
+{
+   uint32_t handle = 0;
+   uint64_t iova = 0;
+   int ret;
+
+   ret = fd_kmt_bo_alloc(to_kmt(dev), size, to_kmt_flags(flags), &handle,
+                         &iova);
+   if (ret) {
+      ERROR_MSG("fd_kmt_bo_alloc(%u) failed: %d", size, ret);
+      return NULL;
+   }
+
+   struct d3dkmt_bo *kbo = calloc(1, sizeof(*kbo));
+   if (!kbo) {
+      fd_kmt_bo_free(to_kmt(dev), handle);
+      return NULL;
+   }
+
+   struct fd_bo *bo = &kbo->base;
+   kbo->gpu_va = iova;
+   bo->size = size;
+   bo->handle = handle;
+   bo->funcs = &funcs;
+
+   fd_bo_init_common(bo, dev);
+
+   return bo;
+}
+
+void
+d3dkmt_bo_close_handle(struct fd_bo *bo)
+{
+   /* Loi chiu trach nhiem Unlock2 + giai phong VA + DestroyAllocation. */
+   fd_kmt_bo_free(to_kmt(bo->dev), bo->handle);
+}
diff --git a/src/freedreno/drm/d3dkmt/d3dkmt_device.c b/src/freedreno/drm/d3dkmt/d3dkmt_device.c
new file mode 100644
index 0000000..5eb9117
--- /dev/null
+++ b/src/freedreno/drm/d3dkmt/d3dkmt_device.c
@@ -0,0 +1,73 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "d3dkmt_priv.h"
+
+static struct fd_bo *
+d3dkmt_bo_from_handle(struct fd_device *dev, uint32_t size, uint32_t handle)
+{
+   /* Import allocation dung chung (shared handle): chua ho tro. */
+   (void)dev; (void)size; (void)handle;
+   return NULL;
+}
+
+static uint32_t
+d3dkmt_handle_from_dmabuf(struct fd_device *dev, int fd)
+{
+   (void)dev; (void)fd;
+   return 0;
+}
+
+static struct fd_bo *
+d3dkmt_bo_from_dmabuf(struct fd_device *dev, int fd)
+{
+   (void)dev; (void)fd;
+   return NULL;
+}
+
+static void
+d3dkmt_device_destroy(struct fd_device *dev)
+{
+   /* fd_device so huu phien kmt (fd_device_new_d3dkmt nhan quyen so huu). */
+   fd_kmt_close(to_kmt(dev));
+}
+
+static const struct fd_device_funcs funcs = {
+   .bo_new = d3dkmt_bo_new,
+   .bo_from_handle = d3dkmt_bo_from_handle,
+   .handle_from_dmabuf = d3dkmt_handle_from_dmabuf,
+   .bo_from_dmabuf = d3dkmt_bo_from_dmabuf,
+   .bo_close_handle = d3dkmt_bo_close_handle,
+   .pipe_new = d3dkmt_pipe_new,
+   .destroy = d3dkmt_device_destroy,
+};
+
+struct fd_device *
+d3dkmt_device_new(struct fd_kmt *kmt)
+{
+   struct d3dkmt_device *d;
+
+   if (!kmt)
+      return NULL;
+
+   d = calloc(1, sizeof(*d));
+   if (!d)
+      return NULL;
+
+   if (fd_kmt_get_info(kmt, &d->info)) {
+      ERROR_MSG("fd_kmt_get_info failed");
+      free(d);
+      return NULL;
+   }
+
+   d->kmt = kmt;
+   d->base.funcs = &funcs;
+   /* Hanh xu nhu drm/msm softpin hien dai: userspace fence, submit_sp. */
+   d->base.version = FD_VERSION_CACHED_COHERENT;
+   d->base.has_cached_coherent = false;
+   d->base.bo_size = sizeof(struct d3dkmt_bo);
+
+   return &d->base;
+}
diff --git a/src/freedreno/drm/d3dkmt/d3dkmt_pipe.c b/src/freedreno/drm/d3dkmt/d3dkmt_pipe.c
new file mode 100644
index 0000000..41de4b5
--- /dev/null
+++ b/src/freedreno/drm/d3dkmt/d3dkmt_pipe.c
@@ -0,0 +1,113 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <inttypes.h>
+
+#include "d3dkmt_priv.h"
+#include "drm/freedreno_ringbuffer_sp.h"
+
+static int
+d3dkmt_pipe_get_param(struct fd_pipe *pipe, enum fd_param_id param,
+                      uint64_t *value)
+{
+   struct d3dkmt_device *d = to_d3dkmt_device(pipe->dev);
+
+   switch (param) {
+   case FD_DEVICE_ID:
+   case FD_GPU_ID:
+      *value = d->info.gpu_id;
+      return 0;
+   case FD_GMEM_SIZE:
+      *value = d->info.gmem_size;
+      return 0;
+   case FD_GMEM_BASE:
+      *value = d->info.gmem_base;
+      return 0;
+   case FD_CHIP_ID:
+      *value = d->info.chip_id;
+      return 0;
+   case FD_NR_PRIORITIES:
+      *value = d->info.nr_priorities ? d->info.nr_priorities : 1;
+      return 0;
+   case FD_VA_SIZE:
+      *value = d->info.va_size;
+      return 0;
+   case FD_TIMESTAMP:
+      return fd_kmt_get_timestamp(d->kmt, value);
+   case FD_CTX_FAULTS:
+   case FD_GLOBAL_FAULTS:
+   case FD_SUSPEND_COUNT:
+      *value = 0;
+      return 0;
+   default:
+      ERROR_MSG("invalid param id: %d", param);
+      return -1;
+   }
+}
+
+static int
+d3dkmt_pipe_set_param(struct fd_pipe *pipe, enum fd_param_id param,
+                      uint64_t value)
+{
+   (void)pipe; (void)param; (void)value;
+   return -1;
+}
+
+static int
+d3dkmt_pipe_wait(struct fd_pipe *pipe, const struct fd_fence *fence,
+                 uint64_t timeout)
+{
+   int ret = fd_kmt_fence_wait(to_kmt(pipe->dev), fence->kfence, timeout);
+   if (ret && ret != -ETIMEDOUT)
+      ERROR_MSG("fd_kmt_fence_wait failed: %d", ret);
+   return ret;
+}
+
+static void
+d3dkmt_pipe_destroy(struct fd_pipe *pipe)
+{
+   fd_pipe_sp_ringpool_fini(pipe);
+   free(to_d3dkmt_pipe(pipe));
+}
+
+static const struct fd_pipe_funcs funcs = {
+   .ringbuffer_new_object = fd_ringbuffer_sp_new_object,
+   .submit_new = d3dkmt_submit_sp_new,
+   .flush = fd_pipe_sp_flush,
+   .get_param = d3dkmt_pipe_get_param,
+   .set_param = d3dkmt_pipe_set_param,
+   .wait = d3dkmt_pipe_wait,
+   .destroy = d3dkmt_pipe_destroy,
+};
+
+struct fd_pipe *
+d3dkmt_pipe_new(struct fd_device *dev, enum fd_pipe_id id, uint32_t prio)
+{
+   struct d3dkmt_device *d = to_d3dkmt_device(dev);
+   (void)prio;
+
+   if (id != FD_PIPE_3D)
+      return NULL;
+
+   if (!(d->info.gpu_id || d->info.chip_id))
+      return NULL;
+
+   struct d3dkmt_pipe *p = calloc(1, sizeof(*p));
+   if (!p)
+      return NULL;
+
+   struct fd_pipe *pipe = &p->base;
+   pipe->dev = dev;
+   pipe->funcs = &funcs;
+
+   INFO_MSG("Pipe Info (d3dkmt):");
+   INFO_MSG(" GPU-id:          %u", d->info.gpu_id);
+   INFO_MSG(" Chip-id:         0x%016" PRIx64, d->info.chip_id);
+   INFO_MSG(" GMEM size:       0x%08x", d->info.gmem_size);
+
+   fd_pipe_sp_ringpool_init(pipe);
+
+   return pipe;
+}
diff --git a/src/freedreno/drm/d3dkmt/d3dkmt_priv.h b/src/freedreno/drm/d3dkmt/d3dkmt_priv.h
new file mode 100644
index 0000000..25c6160
--- /dev/null
+++ b/src/freedreno/drm/d3dkmt/d3dkmt_priv.h
@@ -0,0 +1,51 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ *
+ * Backend freedreno cho Windows/WDDM: moi giao tiep kernel di qua fd_kmt_*
+ * (xem fd_kmt.h). Cau truc mo phong backend msm/ (softpin + submit_sp).
+ */
+
+#ifndef D3DKMT_PRIV_H_
+#define D3DKMT_PRIV_H_
+
+#include "freedreno_drmif.h"
+#include "freedreno_priv.h"
+
+#include "fd_kmt.h"
+
+struct d3dkmt_device {
+   struct fd_device base;
+   struct fd_kmt *kmt;
+   struct fd_kmt_info info;
+};
+FD_DEFINE_CAST(fd_device, d3dkmt_device);
+
+struct fd_device *d3dkmt_device_new(struct fd_kmt *kmt);
+
+static inline struct fd_kmt *
+to_kmt(struct fd_device *dev)
+{
+   return to_d3dkmt_device(dev)->kmt;
+}
+
+struct d3dkmt_pipe {
+   struct fd_pipe base;
+};
+FD_DEFINE_CAST(fd_pipe, d3dkmt_pipe);
+
+struct fd_pipe *d3dkmt_pipe_new(struct fd_device *dev, enum fd_pipe_id id,
+                                uint32_t prio);
+struct fd_submit *d3dkmt_submit_sp_new(struct fd_pipe *pipe);
+
+struct d3dkmt_bo {
+   struct fd_bo base;
+   uint64_t gpu_va;
+};
+FD_DEFINE_CAST(fd_bo, d3dkmt_bo);
+
+struct fd_bo *d3dkmt_bo_new(struct fd_device *dev, uint32_t size,
+                            uint32_t flags);
+void d3dkmt_bo_close_handle(struct fd_bo *bo);
