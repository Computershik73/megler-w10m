+
+int
+fd_kmt_submit(struct fd_kmt *kmt, const struct fd_kmt_cmd *cmds,
+              uint32_t nr_cmds, const struct fd_kmt_bo_ref *bos,
+              uint32_t nr_bos, uint32_t *out_fence)
+{
+   (void)kmt; (void)cmds; (void)nr_cmds; (void)bos; (void)nr_bos;
+   *out_fence = 0;
+   return -ENOSYS;
+}
+
+int
+fd_kmt_fence_wait(struct fd_kmt *kmt, uint32_t fence, uint64_t timeout_ns)
+{
+   (void)kmt; (void)fence; (void)timeout_ns;
+   return -ENOSYS;
+}
