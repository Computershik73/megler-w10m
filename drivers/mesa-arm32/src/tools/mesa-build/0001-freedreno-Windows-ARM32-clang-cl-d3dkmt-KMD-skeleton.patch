+#ifdef _WIN32
+#include <stdio.h>
+#include <sys/types.h>
+typedef ptrdiff_t ssize_t;
+/* MSVC CRT khong co getline(). */
+static ssize_t
+getline(char **lineptr, size_t *n, FILE *stream)
+{
+   size_t len = 0;
+   int c;
+   if (!*lineptr || !*n) {
+      *n = 128;
+      *lineptr = realloc(*lineptr, *n);
+      if (!*lineptr)
+         return -1;
+   }
+   while ((c = fgetc(stream)) != EOF) {
+      if (len + 2 > *n) {
+         *n *= 2;
+         char *p = realloc(*lineptr, *n);
+         if (!p)
+            return -1;
+         *lineptr = p;
+      }
+      (*lineptr)[len++] = (char)c;
+      if (c == 0x0a)
+         break;
+   }
+   if (len == 0)
+      return -1;
+   (*lineptr)[len] = 0;
+   return (ssize_t)len;
+}
