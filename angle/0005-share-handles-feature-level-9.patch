--- a/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp
+++ b/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp
@@ -2468,7 +2468,13 @@
 
     // Also disable share handles on Feature Level 9_3, since it doesn't support share handles on
     // RGBA8 textures/swapchains.
-    if (mRenderer11DeviceCaps.featureLevel <= D3D_FEATURE_LEVEL_9_3)
+    // Megler (angle/0005-share-handles-feature-level-9.patch): but it does on BGRA8 ones. At
+    // feature level 9_3 Direct3D 11 makes a texture shared (D3D11_RESOURCE_MISC_SHARED, and with a
+    // keyed mutex) in B8G8R8A8_UNORM, and a second device of 9_3 or 11_1 opens it and reads what
+    // the first drew; R8G8B8A8_UNORM and both typeless formats it refuses (E_INVALIDARG). So 9_3
+    // has share handles, and SwapChain11 makes only a BGRA8 surface's texture shared there: one of
+    // any other format is made as before, with no handle. Below 9_3, none.
+    if (mRenderer11DeviceCaps.featureLevel < D3D_FEATURE_LEVEL_9_3)
     {
         mSupportsShareHandles = false;
         return false;
--- a/src/libANGLE/renderer/d3d/d3d11/SwapChain11.cpp
