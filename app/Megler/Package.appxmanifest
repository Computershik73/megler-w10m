<?xml version="1.0" encoding="utf-8"?>
<!--
  Megler for Windows 10 Mobile: Android games on a Windows phone, through a
  translation layer.

  tools/build-appx.sh stages this file as AppxManifest.xml, filling in the
  version's fourth field (a build counter, app/Megler/build-number.txt:
  Windows installs only a strictly higher version over an older one) and, for
  the x64 build, ProcessorArchitecture.

  rescap:codeGeneration is what lets Android code run at all: an app's native
  libraries are mapped into memory that VirtualProtectFromApp then makes
  executable, which an app container allows only with this capability. An
  interop-unlocked phone grants it to a sideloaded package. Nothing else
  restricted is asked for: APKs and each app's files live in LocalState, and an
  APK the user picks is copied in.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap2 uap3 mp rescap">

  <Identity
      Name="Megler"
      Publisher="CN=Computershik"
      Version="0.1.0.0"
      ProcessorArchitecture="arm" />

  <mp:PhoneIdentity
      PhoneProductId="af179803-d7e7-4d18-ae09-61b18f61d561"
      PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Megler</DisplayName>
    <PublisherDisplayName>Computershik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 Mobile 1703 (Creators Update) and later. -->
    <TargetDeviceFamily Name="Windows.Mobile" MinVersion="10.0.15063.0" MaxVersionTested="10.0.15254.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.15063.0" MaxVersionTested="10.0.15254.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Megler.exe" EntryPoint="Megler.App">
      <uap:VisualElements
          DisplayName="Megler"
          Description="Android games on Windows 10 Mobile"
          BackgroundColor="#000000"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Megler">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
        <!-- The library is a portrait screen; the player turns the display
             itself (DisplayInformation::AutoRotationPreferences). -->
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <Extensions>
        <!-- APKs and bundles of split APKs open in Megler, from the phone's
             file manager or any app that opens a file (App.cpp,
             OnFileActivated): it asks, then installs one as the picker's.
             An app's own package (shell/AppPackage.cpp) does not have this:
             core/src/appx/mg_appx_manifest.c takes it out. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="apk">
            <uap:DisplayName>Android app</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.android.package-archive">.apk</uap:FileType>
              <uap:FileType>.apks</uap:FileType>
              <uap:FileType>.xapk</uap:FileType>
              <uap:FileType>.apkm</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- megler: links, by which a package of Megler's asks another one
             (Launcher.LaunchUriAsync with that package's family name as its
             target): an app's own package hands Megler an APK an Android app
             wants installed, a launcher starts another app (App.cpp,
             OnActivated). Every app's own package has it too. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="megler">
            <uap:DisplayName>Megler</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Android apps' own network access (the layer's sockets). Android's
         INTERNET permission lets an app reach the home network and accept
         connections too; on Windows those are privateNetworkClientServer
         (devices on the local network, a media server, a printer) and
         internetClientServer (connections coming in). -->
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- An Android app's "SD card" shows the phone's music, pictures and
         videos as folders of it (player/StorageHost.cpp: the capabilities
         let Windows.Storage hand over handles to files there; they do not
         open the folders to the plain file functions). The documents
         library and a memory card are not reached through these on the
         phone tried; a folder there comes in through the folder picker. -->
    <uap:Capability Name="picturesLibrary" />
    <uap:Capability Name="videosLibrary" />
    <uap:Capability Name="musicLibrary" />
    <uap:Capability Name="documentsLibrary" />
    <uap:Capability Name="removableStorage" />
    <!-- The phone's text messages and calls for an Android app (player/PhoneEvents.cpp, the framework's megler.Phone):
         Android's RECEIVE_SMS and READ_SMS, READ_PHONE_STATE and READ_CALL_LOG. A message that comes in and a call of
         the history are told to the app that runs, nothing older: WhatsApp's code comes by a message or by a missed
         call whose number is the code. -->
    <uap:Capability Name="chat" />
    <uap2:Capability Name="phoneCallHistoryPublic" />
    <!-- Sound in the background: an Android app's music or video goes on
         while Megler is minimised, as an app's foreground service keeps it
         going on Android (player/MediaControls.cpp: Windows wants the system
         media controls taken up as well). -->
    <uap3:Capability Name="backgroundMediaPlayback" />
    <!-- Making an Android library's code executable. -->
    <rescap:Capability Name="codeGeneration" />
    <!-- Packages installed, listed and uninstalled by Windows's deployment engine itself (shell/AppPackage.cpp,
         installWithPackageManager), which reads them from where they lie: Megler's own update and the apps' own packages,
         as the stores for Windows 10 Mobile install apps. The phone's Device Portal, whose upload went through Megler's
         memory and could not install Megler's own update on a phone of 1 GB, is asked nothing. -->
    <rescap:Capability Name="packageManagement" />
    <rescap:Capability Name="packageQuery" />
    <!-- The phone's cameras for an Android app's android.hardware.Camera
         (player/CameraHost.cpp): Android's CAMERA permission. Windows asks
         the user the first time an app opens one; until the user says yes,
         and after a no, the app is told it cannot connect to the camera. -->
    <DeviceCapability Name="webcam" />
    <!-- The phone's location for an Android app's LocationManager
         (player/LocationHost.cpp): Android's ACCESS_FINE_LOCATION. Windows
         asks the user the first time an app wants it; after a no, the app is
         told the location is off. -->
    <DeviceCapability Name="location" />
    <!-- The phone's microphone for an Android app's AudioRecord
         (player/MicrophoneHost.cpp): Android's RECORD_AUDIO. Windows asks the
         user the first time an app records; after a no, the app records
         silence. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>

  <!-- The folder every package of this publisher shares (ApplicationData.
       GetPublisherCacheFolder): where Megler puts Android's libcore and framework
       for the packages it makes of single apps, and where those keep their
       shared storage, /sdcard (shell/AppPackage.h, docs/PER-APP-PACKAGES.md).
       Such a package's manifest is this one with its name and ids changed, so
       it declares the same folder. -->
  <Extensions>
    <Extension Category="windows.publisherCacheFolders">
      <PublisherCacheFolders>
        <Folder Name="shared" />
      </PublisherCacheFolders>
    </Extension>
  </Extensions>
</Package>
