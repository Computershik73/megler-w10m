<?xml version="1.0" encoding="utf-8"?>
<!-- The test app of the screen's changes (tools/build-test-app.sh): the test resizes and turns its surface from the host's side
     (megler_set_surface) as the shell does when a PC's window is resized or a phone turned, and reads in the log what Android
     would have the app say.
     Main takes no configuration change itself: it is made again with the state it saved, except where a size changes and crosses
     none of the sizes its resources are made for (values-w700dp). Handled takes them all (android:configChanges) and hears
     onConfigurationChanged; its manifest asks for the screen held upright (sensorPortrait), and a tap on it asks for landscape
     (setRequestedOrientation): the shell hears both. It is exported, so that the test can start it as another app would
     (megler_start_activity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.screen" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <application android:name=".App" android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".Main" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Handled" android:exported="true" android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden" />
    </application>
</manifest>
