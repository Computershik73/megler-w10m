<?xml version="1.0" encoding="utf-8"?>
<!-- The test app for Play Feature Delivery (tools/build-test-app.sh; docs/PLAY-FEATURE-DELIVERY.md): an app that asks the
     Play Store for a feature module as Play Core does it for an app (the bind of com.android.vending under the action
     BIND_SPLIT_INSTALL_SERVICE, ISplitInstallService's transactions written by hand, the callback's, and the receiver of
     the session states) on Megler's stand-in for that service (megler.PlaySplits), which passes the request to the Play
     Store the phone has. A process runs one app, so the test runs this app, then the stand-in for the Play Store
     (playstore), then this app again, over one data folder; the app tells by what it finds which run it is in: no module
     yet, so it asks for one (`extra`) and is told promptly that there is no Play Store, or later that it did not answer;
     the module its own, so its class is loaded, the request asked again is answered from what the Play Store said, and a
     second module (`files`) is asked for; and that one's file there to take, which it copies and loads as SplitCompat
     does. Each step is a line of the log, which the test (core/tests/mg_java_tests.c, run_playclient) reads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.playclient" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <application android:label="@string/app_name">
        <activity android:name=".Main" android:label="@string/app_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
