<?xml version="1.0" encoding="utf-8"?>
<!-- The test app for two apps that work together (tools/build-test-app.sh), as Total Commander and its plug-ins do: this
     one is the app that asks, the test app plugin the one asked, which the test's phone has installed beside it
     (MG_JAVA_OTHER_APKS, core/tests/mg_java_tests.c). It finds the other app installed, resolves an intent to its activity
     and asks for that activity with a whole Intent (an action, data and a type, categories, flags, and extras of every
     kind, Parcelables of classes both apps have among them), which the run of the plugin app that follows reads back
     (run_plugin). Each step is a line of the log, which the test (run_crossapp) reads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.crossapp" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="29" />
    <application android:label="@string/app_name">
        <activity android:name=".Main" android:label="@string/app_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
