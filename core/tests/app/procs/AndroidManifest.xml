<?xml version="1.0" encoding="utf-8"?>
<!-- The test app of an app's processes (tools/build-test-app.sh), as the Google app has them: its launcher activity Main in the
     package's own process and Far in ":far", a service and a receiver in each. Run twice (core/tests/mg_java_tests.c,
     run_procs): from its launcher, and started for Far as another app starts it, its intent reaching FarAlias, when the app
     runs as ":far" and its package's own process is the other one. The first activity binds both services, sends a broadcast both
     receivers take, and starts the other activity for a result; each component says the process it is told by every way an
     app asks (Application.getProcessName, ActivityThread.currentProcessName, Process.myProcessName, ActivityManager,
     /proc/self/cmdline) and which Application it has: the name its Application was made for, and how many were made there.
     Each process's Application puts a security provider of one name first in its process's list, which is the process's own,
     as the Google app's puts SslGuard there; each activity finds its own process's, and the other's taking it out of its
     list leaves the first's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.procs" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <application android:name=".App" android:label="@string/app_name">
        <activity android:name=".Main" android:label="@string/app_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Far" android:label="@string/far" android:process=":far" android:exported="true" />
        <!-- An alias names no process: it runs in its target's. -->
        <activity-alias android:name=".FarAlias" android:targetActivity=".Far" android:exported="true" />
        <service android:name=".Near" android:exported="false" />
        <service android:name=".FarService" android:process=":far" android:exported="false" />
        <receiver android:name=".NearReceiver" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.procs.PING" />
            </intent-filter>
        </receiver>
        <receiver android:name=".FarReceiver" android:process=":far" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.procs.PING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
