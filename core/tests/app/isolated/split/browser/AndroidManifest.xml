<?xml version="1.0" encoding="utf-8"?>
<!-- The feature split "browser" of megler.test.isolated: the app's activity, as Chrome 158's split "chrome" has its browser. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.isolated" split="browser" android:versionCode="1"
          android:isFeatureSplit="true">
    <application android:hasCode="true">
        <activity android:name="megler.test.isolated.browser.Browser" android:label="Isolated">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
