<?xml version="1.0" encoding="utf-8"?>
<!-- The test app of isolated splits (android:isolatedSplits), built as Chrome 158 is: its base has the Application and no
     activity, and its activity is in the feature split "browser"; the feature split "more" uses "browser" (<uses-split>).
     tools/build-test-app.sh builds it as a base and splits (the file `splits` beside this one); the activity says in the log
     what its class loader, its context and the split contexts are, as Android gives them (mg_java_tests.c, run_isolated). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.isolated" android:versionCode="1" android:versionName="1.0"
          android:isolatedSplits="true">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <application android:label="@string/app_name" android:name=".App" />
</manifest>
