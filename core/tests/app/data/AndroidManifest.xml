<?xml version="1.0" encoding="utf-8"?>
<!-- The test app for databases (tools/build-test-app.sh): one Activity that goes through android.database.sqlite as an app does and says in the
     log how each step went. The test runs it twice: what the first run left in its database must be there for the second. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.data" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <application android:label="@string/app_name">
        <!-- Android's legacy Apache HTTP client on the app's class path, as Instagram asks for it (Main's step "apache-http-legacy"). -->
        <uses-library android:name="org.apache.http.legacy" android:required="false" />
        <activity android:name=".Main" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Broadcasts that name their receiver (Main's step "broadcast-explicit"): Relay passes what it hears to Target by an intent
             that names Target, as Spotify's WidgetUpdateCoordinator passes its broadcasts to its widget providers. Off is disabled. -->
        <receiver android:name=".Main$Relay" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.RELAY" />
            </intent-filter>
        </receiver>
        <receiver android:name=".Main$Target" android:exported="false" />
        <!-- Asked for by another app (megler_start_activity, from the test's C side) and finished with a result for it: the result
             of an activity one app starts in another for one (Main's "app-results"). -->
        <activity android:name=".Main$Answer" android:exported="true" />
        <receiver android:name=".Main$Off" android:enabled="false" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.RELAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
