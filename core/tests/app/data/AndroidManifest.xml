<?xml version="1.0" encoding="utf-8"?>
<!-- The test app for databases (tools/build-test-app.sh): one Activity that goes through android.database.sqlite as an app does and says in the
     log how each step went. The test runs it twice: what the first run left in its database must be there for the second. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.data" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <!-- The phone's text messages and calls (Main's phoneEvents): Android gives them to an app that holds these. READ_CALL_LOG
         asked for as WhatsApp asks for it, for Android 6 and later only. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission-sdk-23 android:name="android.permission.READ_CALL_LOG" />
    <!-- Main's step "permissions", which requests them and the four above at run time: the storage, which the user lets the app
         have, and the camera, which the user refuses twice, the second time for good; the contacts, which the shell grants with
         no one asked (it has nothing behind them); a normal one, granted with the install; and WRITE_EXTERNAL_STORAGE asked
         for only up to Android 9, which is no permission of the app's on the Android Megler says it is. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The network security configuration: the test authority trusted for localhost and some names (Main's steps
         "network-trust", "network-trust-domains", "network-trust-pins"), and cleartext as it says ("cleartext"). -->
    <!-- Its Application asks for the process's Application on a thread of its own while it is created, as Tuya Smart's library
         loader does (DataApplication, Main's step "activity-thread-application"). -->
    <application android:name=".DataApplication" android:label="@string/app_name" android:networkSecurityConfig="@xml/network_security_config">
        <!-- Android's legacy Apache HTTP client on the app's class path, as Instagram asks for it (Main's step "apache-http-legacy"). -->
        <uses-library android:name="org.apache.http.legacy" android:required="false" />
        <activity android:name=".Main" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Broadcasts that name their receiver (Main's step "broadcast-explicit"): Relay passes what it hears to Target by an intent
             that names Target, as Spotify's WidgetUpdateCoordinator passes its broadcasts to its widget providers. Off is disabled. -->
        <receiver android:name=".Main$Relay" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.RELAY" />
            </intent-filter>
        </receiver>
        <receiver android:name=".Main$Target" android:exported="false" />
        <!-- Asked for by another app (megler_start_activity, from the test's C side) and finished with a result for it: the result
             of an activity one app starts in another for one (Main's "app-results"). -->
        <activity android:name=".Main$Answer" android:exported="true" />
        <!-- A translucent activity over Main, as TikTok Lite's consent dialog is (Main's "translucent-over", F11). -->
        <activity android:name=".Main$Clear" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:exported="false" />
        <!-- (Off also names Google Play services' SMS Retriever's action, as an app that hears its code so has a receiver for it:
             the report says so, and the app's own package declares the text messages for it: the test's C side, start().) -->
        <receiver android:name=".Main$Off" android:enabled="false" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.RELAY" />
                <action android:name="com.google.android.gms.auth.api.phone.SMS_RETRIEVED" />
            </intent-filter>
        </receiver>
        <!-- An empty process name is the app's own process, as on Android (Play Store's AccountRemovedBroadcastReceiver has one). -->
        <receiver android:name=".Main$Here" android:process="" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.RELAY" />
            </intent-filter>
        </receiver>
        <!-- Started, then stopped from a thread of the app's (Main's step "service-stop-thread"). -->
        <service android:name=".Main$Stopped" android:exported="false" />
        <!-- Started twice, and stopped by its starts' ids (Main's step "start-ids"). -->
        <service android:name=".Main$Twice" android:exported="false" />
        <service android:name=".Main$Again" android:exported="false" />
        <service android:name=".Main$Elsewhere" android:exported="false" android:process=":elsewhere" />
        <service android:name=".Main$Work" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".Main$EngineWork" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- A sync adapter and the provider it syncs (Main's step "sync"), as Gmail has them. -->
        <provider android:name=".Main$Synced" android:authorities="megler.test.sync" android:exported="false" />
        <service android:name=".Main$SyncService" android:exported="false">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/syncadapter" />
        </service>
        <receiver android:name=".Main$Remote" android:process=":remote" android:exported="false">
            <intent-filter>
                <action android:name="megler.test.RELAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
