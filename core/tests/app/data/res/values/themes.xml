<?xml version="1.0" encoding="utf-8"?>
<!-- Main's step "resources-impl": a style of values and of values-night, by which a theme tells which configuration's
     resources it was made of (rebased onto another implementation, it is made of that one's). -->
<resources>
    <style name="ProbeTheme">
        <item name="android:colorForeground">#FF111111</item>
    </style>
    <!-- Main's step "transition-name": a view named for a shared element transition by its style. -->
    <style name="SharedElement">
        <item name="android:transitionName">by-style</item>
    </style>
    <!-- Main's step "theme-switch": the style a context is switched to after its theme was made. -->
    <style name="SwitchedTheme">
        <item name="android:colorForeground">#FF333333</item>
    </style>
    <!-- Main's step "text-appearance-keeps-cursor": a text appearance as the Google app's Gemini field sets after every
         character typed (TextAppearance.Assistant_Gem.Sys.Typography.TypeScale.Static.BodyL has the same textAllCaps), and
         one that turns all caps on. -->
    <style name="InputTextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="CapsTextAppearance">
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
