<?xml version="1.0" encoding="utf-8"?>
<!-- Main's step "table-cells": a table whose rows and cells leave layout_width or layout_height out, as Android lets a
     TableLayout's rows and a TableRow's cells do (Device Info HW's rows are two TextViews with a width and a weight
     alone). The second row says a width, which a table does not heed. -->
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TableRow>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="name" />
        <TextView
            android:layout_weight="2"
            android:text="value" />
    </TableRow>
    <TableRow
        android:layout_width="10px"
        android:layout_height="30px">
        <TextView
            android:layout_height="12px"
            android:text="x" />
    </TableRow>
</TableLayout>
