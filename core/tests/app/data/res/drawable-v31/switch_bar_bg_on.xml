<?xml version="1.0" encoding="utf-8"?>
<!-- Main's step "layout-api-level": the frame's background with the switch on, as the Settings library's settingslib_switch_bar_bg_on. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/switch_bar_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_bar_on" />
            <corners android:radius="@dimen/switch_bar_radius" />
        </shape>
    </item>
</ripple>
