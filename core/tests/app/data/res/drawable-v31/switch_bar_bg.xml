<?xml version="1.0" encoding="utf-8"?>
<!-- Main's step "layout-api-level": the switch bar frame's background, in drawable-v31 alone, as the Settings library's
     settingslib_switch_bar_bg: disabled, on (activated) and off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/switch_bar_bg_off" />
    <item android:state_activated="true" android:drawable="@drawable/switch_bar_bg_on" />
    <item android:state_activated="false" android:drawable="@drawable/switch_bar_bg_off" />
</selector>
