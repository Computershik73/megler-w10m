<?xml version="1.0" encoding="utf-8"?>
<!-- The second test app of the Java driver (tools/build-test-app.sh): what an ordinary small app leans on. It drives itself and says in the log how each thing went. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="megler.test.demos" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <application android:label="@string/app_name">
        <activity android:name=".ListDemo" android:label="@string/app_name" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Second" android:label="@string/second" />
        <activity android:name=".Typing" android:label="@string/typing" />
        <activity android:name=".KeyboardDialogs" />
    </application>
</manifest>
