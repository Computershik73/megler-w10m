
    // Megler: OpenJDK 11's equals, compare, compareUnsigned and mismatch of arrays and of their ranges, which Android 13 (API
    // 33) has and Android 9's Arrays does not: Aliucord Manager's patching of Discord's APK called equals(byte[], int, int,
    // byte[], int, int) and ended on a NoSuchMethodError (package 570). Written plainly, element by element, with the
    // results OpenJDK specifies (floats and doubles compared as Float.compare and Double.compare compare them).

    private static void megler_ranges(int aLength, int aFromIndex, int aToIndex, int bLength, int bFromIndex, int bToIndex) {
        rangeCheck(aLength, aFromIndex, aToIndex);
        rangeCheck(bLength, bFromIndex, bToIndex);
    }

    public static int mismatch(boolean[] a, boolean[] b) {
        int length = Math.min(a.length, b.length);
        if (a == b) return -1;
        for (int i = 0; i < length; i++) if (a[i] != b[i]) return i;
        return a.length == b.length ? -1 : length;
    }

    public static int mismatch(boolean[] a, int aFromIndex, int aToIndex, boolean[] b, int bFromIndex, int bToIndex) {
        megler_ranges(a.length, aFromIndex, aToIndex, b.length, bFromIndex, bToIndex);
        int aLength = aToIndex - aFromIndex, bLength = bToIndex - bFromIndex, length = Math.min(aLength, bLength);
        for (int i = 0; i < length; i++) if (a[aFromIndex + i] != b[bFromIndex + i]) return i;
        return aLength == bLength ? -1 : length;
    }

    public static boolean equals(boolean[] a, int aFromIndex, int aToIndex, boolean[] b, int bFromIndex, int bToIndex) {
        megler_ranges(a.length, aFromIndex, aToIndex, b.length, bFromIndex, bToIndex);
        if (aToIndex - aFromIndex != bToIndex - bFromIndex) return false;
        return mismatch(a, aFromIndex, aToIndex, b, bFromIndex, bToIndex) < 0;
    }

    public static int compare(boolean[] a, boolean[] b) {
        if (a == b) return 0;
        if (a == null || b == null) return a == null ? -1 : 1;
        int i = mismatch(a, b);
        if (i >= 0 && i < Math.min(a.length, b.length)) return Boolean.compare(a[i], b[i]);
        return a.length - b.length;
    }

    public static int compare(boolean[] a, int aFromIndex, int aToIndex, boolean[] b, int bFromIndex, int bToIndex) {
        megler_ranges(a.length, aFromIndex, aToIndex, b.length, bFromIndex, bToIndex);
        int aLength = aToIndex - aFromIndex, bLength = bToIndex - bFromIndex;
        int i = mismatch(a, aFromIndex, aToIndex, b, bFromIndex, bToIndex);
        if (i >= 0 && i < Math.min(aLength, bLength)) return Boolean.compare(a[aFromIndex + i], b[bFromIndex + i]);
        return aLength - bLength;
    }

