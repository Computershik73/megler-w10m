    // Meglet: members added to the original's meglet.Gfx (tools/build-framework.sh, "X.java.members").
    // A comparison of two bitmaps in C, for the tests' check that a window drawn in part (meglet.ViewRoot, overlaid) looks as it
    // would drawn whole: done in Java it would be two arrays of a screen's pixels a frame in a runtime that collects nothing.
    /** How many pixels differ between two bitmaps of one size (-1: they are not) outside the rectangles box[0..3] and box[4..7] (left, top, right, bottom), and then the box round them in box[0..3]. */
    public static native int bmDiffer(long a, long b, int[] box);

    // Display lists, for RenderNode and Picture (the overlay's android/graphics): what a RenderNode's or a Picture's canvas
    // is given is recorded, with its arguments as they are then, and drawn again wherever the node or the picture is drawn,
    // as Android does; the original drew each node into a bitmap of its size, and Compose's dozens of screen-sized layers
    // ended Spotify with an OutOfMemoryError. hk_java_gfx.c's first comment says what is kept and what is referred to.
    /** A canvas that records, its clip (0, 0, width, height) to start with. */
    public static native long cvRecord(int width, int height);
    /** The list a recording canvas made, for the caller to free with dlFree; it records no more. 0: it was not recording. */
    public static native long cvEndRecord(long cv);
    /** Canvas.drawRenderNode: drawn now, or on a recording canvas written to its list as the node itself. */
    public static native void cvDrawNode(long cv, long node);
    /** A Picture's list drawn now, or on a recording canvas written to its list as it is. */
    public static native void cvDrawList(long cv, long list);
    public static native void dlFree(long list);
    /** A RenderNode's native half: its list and the properties it is drawn with. */
    public static native long rnNew();
    public static native void rnFree(long node);
    /** endRecording: the canvas's list becomes the node's. */
    public static native void rnEnd(long node, long cv);
    public static native void rnDiscard(long node);
    /** The node's properties, packed as android.graphics.RenderNode packs them (hk_java_gfx.c, G_rnSet). */
    public static native void rnSet(long node, float[] f, int[] i, float[] outlinePath, int[] layerPaint);
    /** The bytes the node's list takes. */
    public static native long rnBytes(long node);
    /**
     * A layer put onto the picture blurred (meglet.h, save_layer_blur): Android's radii in the matrix's units, and whether what lies
     * outside the layer is its edge carried on (Shader.TileMode CLAMP) rather than transparent (DECAL). For a view with
     * RenderEffect.createBlurEffect (android.view.View.drawFromParent).
     */
    public static native int cvSaveLayerBlur(long cv, float l, float t, float r, float b, int alpha, float radiusX, float radiusY, boolean clamp);
