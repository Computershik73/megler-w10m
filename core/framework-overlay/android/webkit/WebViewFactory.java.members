    // Megler: Android 9's hidden WebViewFactory.getUpdateService, which an app of the platform's own names: the WebView update
    // service as the service manager gives it, the platform's interface answered in the process (megler.PlatformInterfaces:
    // the WebView of the Android root, the one there is). Android's own Settings (AOSP 9) reads the current WebView package
    // through it in Developer options without looking for null, and the generated stub's null ended it there. Null for any
    // other app, which has no such service here.
    public static android.webkit.IWebViewUpdateService getUpdateService() {
        android.os.IBinder b = android.os.ServiceManager.getService("webviewupdate");
        android.os.IInterface i = b == null ? null : b.queryLocalInterface("android.webkit.IWebViewUpdateService");
        return i instanceof android.webkit.IWebViewUpdateService ? (android.webkit.IWebViewUpdateService) i : null;
    }
