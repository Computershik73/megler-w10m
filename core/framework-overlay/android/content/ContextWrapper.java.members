    // Megler: members added to the original's android.content.ContextWrapper (tools/build-framework.sh, "X.java.members").
    // A wrapper answers what the context it wraps answers. For the app's folders on the shared storage the original's
    // wrapper passed on only getExternalFilesDir and let Context's own defaults work the rest out from that; an Activity is
    // a wrapper, so getObbDir() and getExternalMediaDirs() asked of an Activity never reached the context that knows where
    // those folders are (megler.ContextImpl, whose members file says where).
    @Override public java.io.File getObbDir() { return b().getObbDir(); }
    @Override public java.io.File[] getObbDirs() { return b().getObbDirs(); }
    @Override public java.io.File[] getExternalMediaDirs() { return b().getExternalMediaDirs(); }
    @Override public java.io.File getExternalCacheDir() { return b().getExternalCacheDir(); }
    @Override public java.io.File[] getExternalCacheDirs() { return b().getExternalCacheDirs(); }
    @Override public java.io.File[] getExternalFilesDirs(String type) { return b().getExternalFilesDirs(type); }
    // These overloads also retain this wrapper as the receiver's context. Delegating to b() would give a hosted microG
    // receiver the client application's context, while calling the two-argument form would hit Chromium wrappers that throw.
    @Override public Intent registerReceiver(BroadcastReceiver r, IntentFilter f, int flags) { return megler.Broadcasts.register(this, r, f); }
    // With a Handler, the receiver hears on its thread (megler.Broadcasts).
    @Override public Intent registerReceiver(BroadcastReceiver r, IntentFilter f, String perm, android.os.Handler h) { return megler.Broadcasts.register(this, r, f, h); }
    @Override public Intent registerReceiver(BroadcastReceiver r, IntentFilter f, String perm, android.os.Handler h, int flags) {
        return megler.Broadcasts.register(this, r, f, h);
    }
    // And startForegroundService, and the broadcasts with a permission. The original's wrapper did not pass them on, and
    // Context's defaults call this.startService(i) and this.sendBroadcast(i), which reach a subclass of the wrapper that
    // overrides those. microG's ForegroundServiceContext overrides startService to call startForegroundService, which came
    // back to its startService: on without end, until the stack was full (its exposure notifications' trigger, on the boot
    // megler.MicroG gives it). On Android the wrapper passes each on to its base, as now here.
    @Override public ComponentName startForegroundService(Intent service) { return b().startForegroundService(service); }
    @Override public void sendBroadcast(Intent intent, String receiverPermission) { b().sendBroadcast(intent, receiverPermission); }
    @Override public void sendOrderedBroadcast(Intent intent, String receiverPermission) { b().sendOrderedBroadcast(intent, receiverPermission); }
