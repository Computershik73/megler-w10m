    // megler-w10m: members added to the original's megler.EGLNative (tools/build-framework.sh, "X.java.members"); the core's side is
    // core/src/drivers/hk_java_gl.c. A window surface is made with the view it is shown at, and the view says where it is on the
    // screen each time it is drawn with its hole, and that its surface is gone: the core composes the window of the views'
    // picture and the frames of the surfaces under it (docs/ARCHITECTURE.md, "OpenGL ES from an app's Java").
    /** A pbuffer width x height whose frames are shown where the view is; 0 when none could be made. */
    public static native long createWindowSurface(Object view, int width, int height);
    /** Where the view is on the screen, as the picture of the views being drawn has it. */
    public static native void place(Object view, int x, int y, int width, int height);
    /** The view's surface is gone: its frames are no longer shown. */
    public static native void forget(Object view);
