    // Megler: members added to the original's megler.Native (tools/build-framework.sh, "X.java.members").
    /** The host's keyboard for the field it was last asked for (showKeyboard), once more: its text and cursor are as the
     *  keyboard left them, and it keeps what it is composing (megler.h, MEGLER_KEYBOARD_F_AGAIN; megler.InputMethods.ask). */
    public static native void showKeyboardAgain(int inputType, int imeOptions);
    // Which way up the screen is drawn, Display.getRotation's Surface.ROTATION_0 to _270 (megler_set_surface, the core's
    // mg_run_surface); screenWidth, screenHeight and density say the surface as it is now, and change with it (megler.Screen).
    public static native int displayRotation();
    // The battery, asked of the core (mg_battery_read, core/src/run/mg_run.h), which is the one place that knows it: the
    // original's framework had a full battery written into the two classes that answer an app (megler.Broadcasts and
    // android.os.BatteryManager, both overlaid here to ask this instead).
    /** level, scale, status, plugged, health, millivolts, tenths of a degree Celsius, present (1 or 0): the numbers of Android's ACTION_BATTERY_CHANGED. */
    public static native int[] battery();
    /** The calling thread's Android priority (Process.setThreadPriority), -20 to 19: the host thread's after it (core/src/drivers/mg_java.c). */
    public static native void threadNice(int nice);
    /** The SIM as the shell said it (megler_set_cellular): ready (1/0), operator name, MCC+MNC, network type, roaming (1/0),
     *  separated by tabs (core/src/drivers/mg_java.c). */
    public static native String cellular();
    /** The microphone (megler_microphone_host): asked for at `rate` Hz in 1 or 2 channels, true when it hears; stopped;
     *  and what it heard, 16-bit samples, into `b` (blocking: until `n` are there) -- how many (core/src/drivers/mg_java.c). */
    public static native boolean micStart(int rate, int channels);
    public static native void micStop();
    public static native int micRead(short[] b, int off, int n, boolean blocking);
    /** The phone's check of its user (megler_biometric_host, core/src/drivers/mg_java.c), for megler.Biometrics: whether it
     *  can (0 ready, 1 not set up, 2 none); its dialog with the message, blocking until the user is done (0 verified,
     *  1 canceled, 2 locked out, 3 could not check); and that dialog closed from another thread. */
    /** The memory the process may use (the shell's limit; 1 GB where it gives none) and what it uses now, in bytes, as
     *  sysconf's _SC_PHYS_PAGES and /proc/meminfo have them: what ActivityManager.getMemoryInfo tells (core/src/drivers/mg_java.c). */
    public static native long memoryLimit();
    public static native long memoryInUse();
    public static native int biometricAvailable();
    public static native int biometricVerify(String message);
    public static native void biometricCancel();
    /** Where the app's sound is to go, as its AudioManager has it: 0 as ever, 1 the earpiece, 2 the loudspeaker, for a
     *  call (megler_audio_host.route, core/src/drivers/mg_java.c). */
    public static native void audioRoute(int route);
    /** The battery's kind as Android names it, "Li-ion". */
    public static native String batteryTechnology();
    /**
     * The frame meter (core/src/drivers/mg_java.c): 1 a frame begins, with its measure and layout; 2 its draw traversal begins; 3 it
     * has ended, having drawn `redrawn` pixels of the screen. Called by megler.ViewRoot.doFrame on the main thread.
     */
    public static native void frameMark(int phase, int redrawn);
    /**
     * The app's main thread begins to run the app (megler.AppRunner.run, first): the Java driver's sampler watches it from now
     * on, where its time goes and what it waits on (core/src/drivers/mg_java.c, hot_main), not only from its first frame.
     */
    public static native void mainStarted();
    /**
     * Whether the app's main thread stands waiting to enter a monitor that this thread holds, or one whose holder waits to
     * enter one of this thread's: it runs nothing until this thread lets its monitor go (core/src/drivers/mg_java.c, the
     * runtime's mg_dvm_waits_for). For megler.MicroG, whose threads wait for the main thread to attach Google Play services'
     * Application: such a main thread attaches nothing. False on the main thread.
     */
    public static native boolean mainWaitsForMe();
    /**
     * The rectangle of the screen's bitmap that the next Gfx.present on this thread has changed, [left, right) x [top, bottom):
     * the rest is as it was in the picture presented before. Told to the shell where it can take it
     * (megler_window_host.present_pixels_part). Called by megler.ViewRoot.drawAll before it presents part of the screen.
     */
    public static native void presentRect(int left, int top, int right, int bottom);
    /** For the tests (mg_java_check_partial): whether megler.ViewRoot checks each frame drawn in part against the same frame drawn whole. */
    public static native boolean checkPartial();
    /**
     * Shared libraries' APKs (android.content.res.AssetManager.addAssetPathAsSharedLibrary: Android's WebView): opens the APK at
     * that path as one more of the APKs the core reads files of (readApkFile, apkFileFd, apkFileLength), and answers its number
     * among them, the same number for the same path again; -1 when it cannot be read (core/src/drivers/mg_java.c).
     */
    public static native int addApk(String path);
    /**
     * A file of APK number `apk` that the APK stores rather than deflates, as a direct buffer over the file where it lies in
     * the APK, read only and never copied; null for one that is deflated or cannot be viewed (readApkFile reads it then).
     * android.content.res.Resources keeps an app's resources.arsc so, 49.8 MB of Spotify's that sat in its heap.
     */
    public static native java.nio.ByteBuffer mapApkFile(int apk, String path);
    /** The names of the entries of APK number `apk` that lie under `prefix` ("assets/x/"): a file's own name, a folder's name once. */
    public static native String[] listApkFiles(int apk, String prefix);
    /**
     * Google Play services' splits, for an app that hosts them, as it sees them: /system/priv-app/GmsCore/split_<name>.apk,
     * sorted by name, beside GmsCore.apk; none where they came in one APK (megler_run_config.gms_splits_dir; megler.MicroG adds
     * them to their resources).
     */
    public static native String[] gmsSplitPaths();
    /** The phone's name servers now, as text, the network's in use first (core: mg_net_dns_servers): android.net.LinkProperties.getDnsServers. */
    public static native String[] dnsServers();
    /**
     * The phone's bars the app's top window wants hidden -- 1 the status bar, 2 the navigation bar -- and 4 when its status
     * bar is light, so that the bar's icons are to be dark (megler.h, megler_system_bars_host). megler.ViewRoot says it at its
     * first frame and whenever it changes; the shell hides and shows the bars, and the insets that follow come through insets().
     */
    public static native void systemBars(int bars);
    /**
     * The app's active media session's PlaybackState: its state (STATE_*) and the ACTION_* bits it allows; state 0 when it
     * is released or made inactive (megler.h, megler_media_session_host). android.media.session.MediaSession says it.
     */
    public static native void mediaSessionState(int state, long actions);
    /** The phone's accent colour, ARGB, or 0 when the shell told none (megler_set_theme): the platform's accent, Material You's seed. */
    public static native int accentColor();
    /**
     * An APK the app wants installed (or a folder of one app's APKs: a PackageInstaller session's), by its path among the app's
     * own files: Megler's installer has it (megler_system_host.install_apk). True when the shell took it.
     */
    public static native boolean installApk(String path, String name);
    /** Another app the phone has, started: its package, and its activity's class or null for its launcher activity. */
    public static native boolean launchApp(String packageName, String activity);
    /**
     * The apps the phone has (megler_run_config.apps_dir), a line for each: package, launcher activity, label, version name,
     * version code, separated by tabs; null when the shell told none. megler.PhoneApps reads it.
     */
    public static native String appsList();
    /** That app's icon, a PNG; null when there is none. */
    public static native byte[] appIcon(String packageName);
    /** That app's activities as the shell described them for a launcher (megler_apk_describe_activities): the bytes of its
     *  activities.json, UTF-8; null when there are none (core/src/drivers/mg_java.c). */
    public static native byte[] appActivities(String packageName);
    /** The picture of that app's icon resource `id` (one its activities name), a PNG; null when there is none. */
    public static native byte[] appResIcon(String packageName, int id);
    /** What Megler last wrote of the APK it was handed under `name` (installApk): installs/<name>.txt of the same folder,
     *  "<when>\t<what>\t<why>", UTF-8 -- declined, incompatible, failed or busy; null when it has written nothing. */
    public static native byte[] appInstall(String name);
    /** Another app the phone has, to uninstall (megler_system_host.uninstall_app): true when the shell asks the user. */
    public static native boolean uninstallApp(String packageName);
    /** Whether the app may have what a dangerous permission group guards (megler_system_host.permission, megler.Permissions):
     *  0 undecided, 1 granted, 2 denied (may be asked again), 3 denied for good. With `ask` the user is asked first and this
     *  thread waits, as long as they take: never on the main thread. A shell without it grants every group. */
    public static native int permission(String group, boolean ask);
    /** The phone's picker of files (kind 0) or its camera, for a photo (1) or a video (2) (megler_system_host.pick, megler.Pickers):
     *  request `id`, the MIME types each followed by '\n', several or one (at most `max`, 0 none), the request's folder as the
     *  app sees it, where the shell puts what was picked or taken, a video's limit and quality (-1 none said), and where the
     *  picker starts (0 documents, 1 pictures, 2 videos, 3 music). Returns at once: true when the shell will answer -- an
     *  event for the main thread, which takes the answer with pickAnswer -- false when it will not. */
    public static native boolean pick(int id, int kind, String types, boolean multiple, int max, String folder, int durationS, int quality, int start);
    /** The shell's answer to request `id`, taken: { status (0 picked, 1 backed out, 2 failed), the files' names... }; null while none came. */
    public static native String[] pickAnswer(int id);
    /** A colour of Material You's palettes made from a seed (megler_palette_tone): palette 0 neutral 1 ... 5 error, tone 0 to 100. */
    public static native int paletteTone(int seed, int palette, int tone);
    /** What that session plays: title, artist, album (or null), and a picture of at most 256x256 as ARGB pixels, or null. */
    public static native void mediaSessionMetadata(String title, String artist, String album, int[] art, int artWidth, int artHeight);
    /** A switch for trying something on the phone (core: mg_flag): on when a file of that name is in the data folder's flags. */
    public static native boolean flag(String name);
    /** Asks the core to clear this app's data when it next starts (megler.h, megler_ask_clear_data): Android's Clear storage. */
    public static native boolean askClearData();
    /** Asks the core to clear this app's cache when it next starts (megler.h, megler_ask_clear_cache): Android's Clear cache. */
    public static native boolean askClearCache();
    /** What the app did with the Back numbered seq (megler_back; AppRunner.back): 0 took it, 1 showed nothing new yet, 2 went
     *  to the back, 3 ended its last activity (core/src/drivers/mg_java.c). */
    public static native void backDone(int seq, int answer);
    /** The app went to the back (AppRunner.moveTaskToBack): the Back being waited for, or the shell's next one, is the system's. */
    public static native void toBack();
    /**
     * A folder of the app's storage listed in one call, each entry with its kind, size and time: "d" or "f", the size in bytes,
     * "/", the time of its last change in milliseconds since 1970, "/", its id (0: not known), "/", the name, "/", one after
     * another, the folder itself first as "."; null when it cannot be listed (core/src/drivers/mg_java.c, mg_path_list_stat).
     * For megler.MediaProvider, which indexes the shared storage: File.length() and lastModified() of each file in the
     * phone's own folders were two calls to Windows' broker each.
     */
    public static native String listFolder(String path);
    /**
     * Windows' own picture of a file in one of the phone's folders (megler_storage_host.thumbnail): the bytes of an image file
     * (BMP, JPEG or PNG), upright as Windows sees the file, its longer side about `size`; null for a file in none of them, a
     * shell that makes none, none to be had or none within eight seconds. `mode` is megler.h's MEGLER_THUMBNAIL_* (0 the
     * whole picture, 1 cut square). The caller waits (core/src/drivers/mg_java.c); the shell answers on a thread of its own.
     */
    public static native byte[] storageThumbnail(String path, int size, int mode);
