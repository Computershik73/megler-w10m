    // Megler: members added to the original's megler.Native (tools/build-framework.sh, "X.java.members").
    // The battery, asked of the core (mg_battery_read, core/src/run/mg_run.h), which is the one place that knows it: the
    // original's framework had a full battery written into the two classes that answer an app (megler.Broadcasts and
    // android.os.BatteryManager, both overlaid here to ask this instead).
    /** level, scale, status, plugged, health, millivolts, tenths of a degree Celsius, present (1 or 0): the numbers of Android's ACTION_BATTERY_CHANGED. */
    public static native int[] battery();
    /** The battery's kind as Android names it, "Li-ion". */
    public static native String batteryTechnology();
    /**
     * The frame meter (core/src/drivers/mg_java.c): 1 a frame begins, with its measure and layout; 2 its draw traversal begins; 3 it
     * has ended, having drawn `redrawn` pixels of the screen. Called by megler.ViewRoot.doFrame on the main thread.
     */
    public static native void frameMark(int phase, int redrawn);
    /**
     * The rectangle of the screen's bitmap that the next Gfx.present on this thread has changed, [left, right) x [top, bottom):
     * the rest is as it was in the picture presented before. Told to the shell where it can take it
     * (megler_window_host.present_pixels_part). Called by megler.ViewRoot.drawAll before it presents part of the screen.
     */
    public static native void presentRect(int left, int top, int right, int bottom);
    /** For the tests (mg_java_check_partial): whether megler.ViewRoot checks each frame drawn in part against the same frame drawn whole. */
    public static native boolean checkPartial();
    /**
     * Shared libraries' APKs (android.content.res.AssetManager.addAssetPathAsSharedLibrary: Android's WebView): opens the APK at
     * that path as one more of the APKs the core reads files of (readApkFile, apkFileFd, apkFileLength), and answers its number
     * among them, the same number for the same path again; -1 when it cannot be read (core/src/drivers/mg_java.c).
     */
    public static native int addApk(String path);
    /** The names of the entries of APK number `apk` that lie under `prefix` ("assets/x/"): a file's own name, a folder's name once. */
    public static native String[] listApkFiles(int apk, String prefix);
    /** The phone's name servers now, as text, the network's in use first (core: mg_net_dns_servers): android.net.LinkProperties.getDnsServers. */
    public static native String[] dnsServers();
    /**
     * The phone's bars the app's top window wants hidden -- 1 the status bar, 2 the navigation bar -- and 4 when its status
     * bar is light, so that the bar's icons are to be dark (megler.h, megler_system_bars_host). megler.ViewRoot says it at its
     * first frame and whenever it changes; the shell hides and shows the bars, and the insets that follow come through insets().
     */
    public static native void systemBars(int bars);
    /**
     * The app's active media session's PlaybackState: its state (STATE_*) and the ACTION_* bits it allows; state 0 when it
     * is released or made inactive (megler.h, megler_media_session_host). android.media.session.MediaSession says it.
     */
    public static native void mediaSessionState(int state, long actions);
    /** The phone's accent colour, ARGB, or 0 when the shell told none (megler_set_theme): the platform's accent, Material You's seed. */
    public static native int accentColor();
    /**
     * An APK the app wants installed (or a folder of one app's APKs: a PackageInstaller session's), by its path among the app's
     * own files: Megler's installer has it (megler_system_host.install_apk). True when the shell took it.
     */
    public static native boolean installApk(String path, String name);
    /** Another app the phone has, started: its package, and its activity's class or null for its launcher activity. */
    public static native boolean launchApp(String packageName, String activity);
    /**
     * The apps the phone has (megler_run_config.apps_dir), a line for each: package, launcher activity, label, version name,
     * version code, separated by tabs; null when the shell told none. megler.PhoneApps reads it.
     */
    public static native String appsList();
    /** That app's icon, a PNG; null when there is none. */
    public static native byte[] appIcon(String packageName);
    /** That app's activities as the shell described them for a launcher (megler_apk_describe_activities): the bytes of its
     *  activities.json, UTF-8; null when there are none (core/src/drivers/mg_java.c). */
    public static native byte[] appActivities(String packageName);
    /** The picture of that app's icon resource `id` (one its activities name), a PNG; null when there is none. */
    public static native byte[] appResIcon(String packageName, int id);
    /** A colour of Material You's palettes made from a seed (megler_palette_tone): palette 0 neutral 1 ... 5 error, tone 0 to 100. */
    public static native int paletteTone(int seed, int palette, int tone);
    /** What that session plays: title, artist, album (or null), and a picture of at most 256x256 as ARGB pixels, or null. */
    public static native void mediaSessionMetadata(String title, String artist, String album, int[] art, int artWidth, int artHeight);
    /** A switch for trying something on the phone (core: mg_flag): on when a file of that name is in the data folder's flags. */
    public static native boolean flag(String name);
    /** Asks the core to clear this app's data when it next starts (megler.h, megler_ask_clear_data): Android's Clear storage. */
    public static native boolean askClearData();
