    // megler-w10m: members added to the original's megler.Native (tools/build-framework.sh, "X.java.members").
    // The battery, asked of the core (hk_battery_read, core/src/run/hk_run.h), which is the one place that knows it: the
    // original's framework had a full battery written into the two classes that answer an app (megler.Broadcasts and
    // android.os.BatteryManager, both overlaid here to ask this instead).
    /** level, scale, status, plugged, health, millivolts, tenths of a degree Celsius, present (1 or 0): the numbers of Android's ACTION_BATTERY_CHANGED. */
    public static native int[] battery();
    /** The battery's kind as Android names it, "Li-ion". */
    public static native String batteryTechnology();
    /**
     * The frame meter (core/src/drivers/hk_java.c): 1 a frame begins, with its measure and layout; 2 its draw traversal begins; 3 it
     * has ended, having drawn `redrawn` pixels of the screen. Called by megler.ViewRoot.doFrame on the main thread.
     */
    public static native void frameMark(int phase, int redrawn);
    /**
     * The rectangle of the screen's bitmap that the next Gfx.present on this thread has changed, [left, right) x [top, bottom):
     * the rest is as it was in the picture presented before. Told to the shell where it can take it
     * (megler_window_host.present_pixels_part). Called by megler.ViewRoot.drawAll before it presents part of the screen.
     */
    public static native void presentRect(int left, int top, int right, int bottom);
    /** For the tests (hk_java_check_partial): whether megler.ViewRoot checks each frame drawn in part against the same frame drawn whole. */
    public static native boolean checkPartial();
    /**
     * Shared libraries' APKs (android.content.res.AssetManager.addAssetPathAsSharedLibrary: Android's WebView): opens the APK at
     * that path as one more of the APKs the core reads files of (readApkFile, apkFileFd, apkFileLength), and answers its number
     * among them, the same number for the same path again; -1 when it cannot be read (core/src/drivers/hk_java.c).
     */
    public static native int addApk(String path);
    /** The names of the entries of APK number `apk` that lie under `prefix` ("assets/x/"): a file's own name, a folder's name once. */
    public static native String[] listApkFiles(int apk, String prefix);
    /** The phone's name servers now, as text, the network's in use first (core: hk_net_dns_servers): android.net.LinkProperties.getDnsServers. */
    public static native String[] dnsServers();
    /**
     * The phone's bars the app's top window wants hidden -- 1 the status bar, 2 the navigation bar -- and 4 when its status
     * bar is light, so that the bar's icons are to be dark (megler.h, megler_system_bars_host). megler.ViewRoot says it at its
     * first frame and whenever it changes; the shell hides and shows the bars, and the insets that follow come through insets().
     */
    public static native void systemBars(int bars);
