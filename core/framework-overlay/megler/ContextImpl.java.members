    // Megler: members added to the original's megler.ContextImpl (tools/build-framework.sh, "X.java.members").
    // The configuration changed (megler.Screen): the callbacks registered with this context hear it, as those registered with
    // a context's application do on Android -- the original kept them and never called them.
    public void meglerConfigurationChanged(Configuration c) {
        for (ComponentCallbacks cb : new java.util.ArrayList<>(mCallbacks)) cb.onConfigurationChanged(c);
    }
    // The app's own folders on the shared storage other than its files: Android/obb/<package> and Android/media/<package>,
    // made when first asked for, as Android makes them. The original's Context answers both from getExternalFilesDir:
    // getObbDir() was Android/data/<package> -- the parent of the files folder, where an app that unpacks its expansion file
    // would write beside its own cache -- and getExternalMediaDirs() the files folder itself.
    @Override public File getObbDir() {
        File f = new File(Native.externalDir(), "Android/obb/" + getPackageName());
        f.mkdirs();
        return f;
    }
    @Override public File[] getObbDirs() { return new File[] { getObbDir() }; }
    @Override public File[] getExternalMediaDirs() {
        File f = new File(Native.externalDir(), "Android/media/" + getPackageName());
        f.mkdirs();
        return new File[] { f };
    }
    // The broadcasts with a result receiver, with options or a user, which the original's Context left doing nothing: each
    // to the receivers as sendBroadcast sends it, an ordered one in turn, its result from one to the next and at the end to
    // its result receiver (megler.Broadcasts.sendOrdered). Play Store sends its own receivers one as it takes an install up.
    // The user, the app-op and the options do not matter here: there is one user, and every broadcast is the app's own.
    @Override public void sendBroadcast(android.content.Intent i, String perm, int appOp) { Broadcasts.send(this, i, perm); }
    @Override public void sendBroadcast(android.content.Intent i, String perm, android.os.Bundle options) { Broadcasts.send(this, i, perm); }
    @Override public void sendBroadcastAsUser(android.content.Intent i, android.os.UserHandle u) { Broadcasts.send(this, i); }
    @Override public void sendBroadcastAsUser(android.content.Intent i, android.os.UserHandle u, String perm) { Broadcasts.send(this, i, perm); }
    @Override public void sendBroadcastAsUser(android.content.Intent i, android.os.UserHandle u, String perm, int appOp) { Broadcasts.send(this, i, perm); }
    @Override public void sendBroadcastAsUser(android.content.Intent i, android.os.UserHandle u, String perm, android.os.Bundle options) { Broadcasts.send(this, i, perm); }
    @Override public void sendOrderedBroadcast(android.content.Intent i, String perm, android.os.Bundle options) { Broadcasts.sendOrdered(this, i, perm, null, null, 0, null, null); }
    @Override public void sendOrderedBroadcast(android.content.Intent i, String perm, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcast(android.content.Intent i, String perm, android.os.Bundle options, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcast(android.content.Intent i, String perm, String appOp, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcast(android.content.Intent i, String perm, int appOp, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcast(android.content.Intent i, int code, String perm, String appOp, android.content.BroadcastReceiver r, android.os.Handler h, String data, android.os.Bundle extras, android.os.Bundle options) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcastAsUser(android.content.Intent i, android.os.UserHandle u, String perm, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcastAsUser(android.content.Intent i, android.os.UserHandle u, String perm, int appOp, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
    @Override public void sendOrderedBroadcastAsUser(android.content.Intent i, android.os.UserHandle u, String perm, int appOp, android.os.Bundle options, android.content.BroadcastReceiver r, android.os.Handler h, int code, String data, android.os.Bundle extras) {
        Broadcasts.sendOrdered(this, i, perm, r, h, code, data, extras);
    }
